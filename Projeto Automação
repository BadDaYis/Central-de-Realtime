def parse_horario(h):
    try:
        a, b = [p.strip() for p in h.replace("–", "-").split("-")]
        ini = int(a[:2]) * 60 + int(a[3:5])
        fim = int(b[:2]) * 60 + int(b[3:5])
        return ini, fim if fim > ini else fim + 1440
    except (ValueError, IndexError, AttributeError):
        return None


def em_horario(h, now=None):
    j = parse_horario(h)
    if not j:
        return False
    now = now or datetime.now()
    m = now.hour * 60 + now.minute
    return j[0] <= m < j[1]


def intervalo(now, passo=30):
    ini = now.replace(minute=now.minute - now.minute % passo, second=0, microsecond=0)
    return ini, ini + timedelta(minutes=passo)


def fmt_quando(dt, now=None):
    now = now or datetime.now()
    if dt.date() == now.date():
        return f"hoje às {dt:%H:%M}"
    if dt.date() == (now - timedelta(days=1)).date():
        return f"ontem às {dt:%H:%M}"
    return dt.strftime("%d/%m às %H:%M")


def status_destino(info):
    if not info.get("acessivel"):
        return "Pasta inacessível", C.ERR
    if not info["existe"]:
        return "Ainda não existe", C.WARN
    cor = C.OK if info["mtime"].date() == datetime.now().date() else C.WARN
    return f"Atualizado {fmt_quando(info['mtime'])}", cor


