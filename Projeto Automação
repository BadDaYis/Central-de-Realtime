        pady=5).pack(anchor="w", pady=(4, 0))

    resultado = tk.Label(extra, font=fnt(9), bg=C.SURFACE, anchor="w", justify="left", wraplength=600)
    auto_wrap(resultado, 0)

    def coletar():
        op, nome, assunto = cp_op.valor(), cp_nome.valor(), cp_assunto.valor()
        faltam = [n for n, v in (("operação", op), ("nome", nome), ("trecho do assunto", assunto)) if not v]
        if faltam:
            self.toast.show("Campos obrigatórios", "Preencha " + juntar(faltam) + ".", "warn")
            return None
        try:
            ciclo = int(cp_ciclo.valor() or 0)
        except ValueError:
            self.toast.show("Ciclo inválido", "Use um número inteiro de minutos.", "warn")
            return None
        blocos = []
        for b in linhas_bloco:
            if b["planilha"].valor() and b["aba"].valor() and b["intervalo"].valor():
                blocos.append({"titulo": b["titulo"].valor(), "planilha": b["planilha"].valor(),
                               "aba": b["aba"].valor(), "intervalo": b["intervalo"].valor().upper(),
                               "como": b["como"].valor})
        cfg = {
            "id": atual.get("id") or _slug(f"{op}-{nome}"),
            "operacao": op, "nome": nome, "descricao": cp_desc.valor() or nome,
            "modo": seg_modo.valor, "assunto": assunto,
            "remetente": cp_rem.valor() if seg_modo.valor == "responder" else "",
            "assunto_novo": cp_novo.valor() if seg_modo.valor == "thread" else "",
            "dias_referencia": int(seg_dia.valor), "ciclo_min": ciclo,
            "manter_historico": chk_hist.valor,
            "corpo": txt_corpo.get("1.0", "end").rstrip(),
            "checklist": [l.strip() for l in txt_check.get("1.0", "end").splitlines() if l.strip()],
            "blocos_excel": blocos,
        }
        if cp_hor is not None and cp_hor.valor():
            cfg["horario"] = cp_hor.valor()
        return cfg

    def salvar():
        cfg = coletar()
        if not cfg:
            return
        dados = [c for c in carregar_config_emails() if c.get("id") != cfg["id"]]
        if nova and any(c.get("id") == cfg["id"] for c in carregar_config_emails()):
            cfg["id"] = f"{cfg['id']}-{datetime.now():%H%M%S}"
        dados.append(cfg)
        try:
            salvar_config_emails(dados)
        except OSError as e:
            self.toast.show("Não foi possível salvar", str(e), "err")
            return
        aplicar_config_emails(dados)
        with _STATUS_LOCK:
            _STATUS_CACHE.clear()
        self._nav_assinatura = None
        self.toast.show("Configuração salva", f"{cfg['operacao']} · {cfg['nome']}")
        self.show_config_emails(cfg["id"])

    def excluir():
        if not messagebox.askyesno("Excluir verificação",
                                   f"Excluir '{atual.get('nome')}' de {atual.get('operacao')}?\n"
                                   "Isso vale para toda a equipe.", icon="warning", parent=self.root):
            return
        dados = [c for c in carregar_config_emails() if c.get("id") != atual.get("id")]
        try:
            salvar_config_emails(dados)
        except OSError as e:
            self.toast.show("Não foi possível salvar", str(e), "err")
            return
        aplicar_config_emails(dados)
        self._nav_assinatura = None
        self.toast.show("Verificação excluída", atual.get("nome", ""), "warn")
        self.show_config_emails()

    def testar():
        cfg = coletar()
        if not cfg:
            return
        vf = _verificacao_de_config(cfg)
        resultado.configure(text="Consultando o Outlook...", fg=C.MUTED)
        resultado.pack(fill="x", pady=(12, 0), before=acoes)

        def fim(res):
            if not resultado.winfo_exists():
                return
            r = (res or {}).get("teste") or {"estado": "erro", "texto": "Falha inesperada. Veja app.log."}
            cor_r = {"ok": C.OK, "pendente": C.WARN, "erro": C.ERR}.get(r["estado"], C.TEXT2)
            extra_txt = f"\nE-mail encontrado: {r['assunto']}" if r.get("assunto") else ""
            if r.get("alvo") and not r.get("assunto"):
                extra_txt = f"\nE-mail encontrado: {r['alvo'].get('assunto', '')}"
            resultado.configure(text=f"Resultado do teste: {r['texto']}{extra_txt}", fg=cor_r)

        run_async(resultado, lambda: consultar_caixa([("teste", vf)]), fim)

    acoes = tk.Frame(extra, bg=C.SURFACE)
    acoes.pack(fill="x", pady=(18, 0))
    Btn(acoes, "Salvar", salvar, kind="primary", size=10, pady=8).pack(side="left")
    Btn(acoes, "Testar no Outlook", testar if OUTLOOK_OK else None, kind="ghost", size=10, pady=8,
        enabled=OUTLOOK_OK).pack(side="left", padx=(10, 0))
    if not nova:
        Btn(acoes, "Excluir", excluir, kind="danger", size=10, pady=8).pack(side="right")
    Btn(acoes, "Cancelar", lambda: self.show_config_emails(), kind="quiet", size=10,
        pady=8).pack(side="right", padx=(0, 10))
    tk.Frame(B, bg=C.INK, height=36).pack()


