            box["r"] = fn()
        except Exception as e:
            logging.exception("Erro em tarefa em segundo plano")
            box["e"] = e

    t = threading.Thread(target=work, daemon=True)
    t.start()

    def poll():
        if not widget.winfo_exists():
            return
        if t.is_alive():
            widget.after(60, poll)
        else:
            done(box.get("r"))

    widget.after(60, poll)


def ponteiro_dentro(widget):
    try:
        w = widget.winfo_containing(*widget.winfo_pointerxy())
    except (KeyError, tk.TclError):
        return False
    while w is not None:
        if w is widget:
            return True
        w = w.master
    return False


