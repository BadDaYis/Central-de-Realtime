def _como_hora(val):
    if val is None:
        return None
    if isinstance(val, datetime):
        return val.time()
    if isinstance(val, dt_time):
        return val
    if isinstance(val, (int, float)) and 0 <= val < 1:
        seg = round(val * 86400)
        return dt_time(seg // 3600 % 24, seg % 3600 // 60)
    m = _RE_HORA.match(str(val).strip())
    if m and int(m.group(1)) < 24:
        return dt_time(int(m.group(1)), int(m.group(2)))
    return None


def _fmt_celula(v):
    if v is None:
        return ""
    if isinstance(v, (datetime, dt_time)):
        return v.strftime("%H:%M")
    if isinstance(v, float) and v.is_integer():
        return str(int(v))
    return str(v)


def ler_resumo_cardif(caminho_planilha, sheet_nome="RESUMO", passo_min=30):
    if not os.path.exists(caminho_planilha):
        return False, f"Planilha não encontrada: {caminho_planilha}"
    try:
        wb = load_workbook(caminho_planilha, read_only=True, data_only=True)
    except Exception as e:
        return False, f"Erro ao abrir planilha: {e}"
    try:
        if sheet_nome not in wb.sheetnames:
            return False, f"Aba '{sheet_nome}' não encontrada."
        linhas = [list(r) for r in wb[sheet_nome].iter_rows(min_row=1, max_col=17, values_only=True)]
    finally:
        wb.close()

    limite, _ = intervalo(datetime.now(), passo_min)
    limite = limite.time()

    def ler_tabela(c_ini, c_fim):
        cab = linhas[0] if linhas else []
        headers = [_fmt_celula(cab[c]) if c < len(cab) else "" for c in range(c_ini, c_fim + 1)]
        rows = []
        for lin in linhas[1:]:
            hora = _como_hora(lin[c_ini]) if c_ini < len(lin) else None
            if hora is None or hora >= limite:
                break
            rows.append([_fmt_celula(lin[c]) if c < len(lin) else "" for c in range(c_ini, c_fim + 1)])
        return headers, rows

    headers_wa, rows_wa = ler_tabela(9, 11)
    headers_as, rows_as = ler_tabela(14, 16)

    if not rows_wa and not rows_as:
        sem_calculo = len(linhas) > 1 and all(v is None for v in linhas[1][9:12])
        if sem_calculo:
            return False, ("A aba RESUMO está sem valores calculados. Abra a planilha no Excel, "
                           "salve e tente de novo.")
        return False, f"Nenhum intervalo fechado antes de {limite:%H:%M}."

    def tabela_html(titulo, headers, rows):
        if not rows:
            return ""
        partes = [f'<p><b><i>{titulo}:</i></b></p>',
                  '<table border="1" cellpadding="4" cellspacing="0" '
                  'style="border-collapse:collapse;font-family:Calibri,Arial,sans-serif;font-size:10pt;">',
                  '<tr style="background-color:#4472C4;color:white;font-weight:bold;">']
        partes += [f'<td style="padding:4px 8px;">{h}</td>' for h in headers]
        partes.append('</tr>')
        for i, row in enumerate(rows):
            bg = "#D9E2F3" if i % 2 == 0 else "#FFFFFF"
            partes.append(f'<tr style="background-color:{bg};">')
            partes += [f'<td style="padding:4px 8px;">{v}</td>' for v in row]
            partes.append('</tr>')
        partes.append('</table>')
        return "\n".join(partes)

    corpo = ('<div style="font-family:Calibri,Arial,sans-serif;font-size:11pt;color:#333;">\n'
             + tabela_html("WhatsApp", headers_wa, rows_wa)
             + '<br>\n'
             + tabela_html("WhatsApp After Sales", headers_as, rows_as)
             + '</div>')
    return True, corpo


class Rolagem(tk.Frame):
    def __init__(self, parent, bg=C.INK, estilo="WFM.Vertical.TScrollbar"):
        super().__init__(parent, bg=bg)
        self.canvas = tk.Canvas(self, bg=bg, highlightthickness=0)
        self.sb = ttk.Scrollbar(self, orient="vertical", command=self.canvas.yview,
                                style=estilo)
        self.inner = tk.Frame(self.canvas, bg=bg)
        self.win = self.canvas.create_window((0, 0), window=self.inner, anchor="nw")
        self.inner.bind("<Configure>", lambda e: self.canvas.configure(scrollregion=self.canvas.bbox("all")))
        self._larg = None
        self.canvas.bind("<Configure>", self._ajustar_largura)
        self.canvas.configure(yscrollcommand=self.sb.set)
        self.sb.pack(side="right", fill="y")
        self.canvas.pack(side="left", fill="both", expand=True)

    def _ajustar_largura(self, e):
        if e.width != self._larg:
            self._larg = e.width
            self.canvas.itemconfigure(self.win, width=e.width)

    def rolar(self, passos):
        if self.canvas.yview() != (0.0, 1.0):
            self.canvas.yview_scroll(passos, "units")

    def limpar(self):
        for w in self.inner.winfo_children():
            w.destroy()
        self.canvas.yview_moveto(0)


