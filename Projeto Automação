class Btn(tk.Label):
    KINDS = {
        "primary": (C.ACCENT, C.INK, "#BCAFFF"),
        "ghost": (C.RAISED, C.TEXT, C.HOVER),
        "quiet": (C.INK, C.TEXT2, C.SURFACE),
        "ok": (C.OK, C.INK, C.OK),
        "danger": (C.ERR, C.TEXT, "#FF7A70"),
    }

    def __init__(self, parent, text, command=None, kind="ghost", size=10, padx=18, pady=8, enabled=True):
        super().__init__(parent, text=text, font=fnt(size, "bold"), padx=padx, pady=pady, takefocus=1,
                         highlightthickness=2, highlightbackground=parent.cget("bg"), highlightcolor=C.ACCENT)
        self.command, self.kind, self.enabled = command, kind, enabled
        self._paint()
        self.bind("<Enter>", lambda e: self._paint(True))
        self.bind("<Leave>", lambda e: self._paint())
        self.bind("<ButtonRelease-1>", self._release)
        self.bind("<Return>", lambda e: self._click())
        self.bind("<space>", lambda e: self._click())

    def _paint(self, hover=False):
        if not self.enabled:
            self.configure(bg=C.RAISED, fg=C.MUTED, cursor="arrow")
            return
        bg, fg, hv = self.KINDS[self.kind]
        self.configure(bg=hv if hover and self.command else bg, fg=fg,
                       cursor="hand2" if self.command else "arrow")

    def _release(self, e):
        if 0 <= e.x < self.winfo_width() and 0 <= e.y < self.winfo_height():
            self._click()

    def _click(self):
        if self.enabled and self.command:
            self.command()

    def set(self, text=None, enabled=None, kind=None, command=False):
        if text is not None:
            self.configure(text=text)
        if enabled is not None:
            self.enabled = enabled
        if kind is not None:
            self.kind = kind
        if command is not False:
            self.command = command
        self._paint()


