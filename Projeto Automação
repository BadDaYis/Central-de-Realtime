def list_downloads():
    exts = {".xlsx", ".xls", ".csv", ".tsv", ".txt", ".pdf", ".xlsm"}
    out = []
    try:
        nomes = os.listdir(PASTA_DOWNLOADS)
    except OSError:
        return out
    for f in nomes:
        if f.startswith("~$"):
            continue
        p = os.path.join(PASTA_DOWNLOADS, f)
        ext = os.path.splitext(f)[1].lower()
        if ext not in exts or not os.path.isfile(p):
            continue
        try:
            st = os.stat(p)
        except OSError:
            continue
        if st.st_size < 100:
            continue
        mt = datetime.fromtimestamp(st.st_mtime)
        out.append({"nome": f, "caminho": p, "ext": ext, "tam_fmt": fmt_size(st.st_size),
                    "mtime": mt, "mod": mt.strftime("%d/%m/%Y %H:%M")})
    out.sort(key=lambda x: x["mtime"], reverse=True)
    return out


def check_dest(dest_dir, filename):
    if not os.path.isdir(dest_dir):
        return {"existe": False, "acessivel": False}
    p = os.path.join(dest_dir, filename)
    if os.path.exists(p):
        mt = datetime.fromtimestamp(os.path.getmtime(p))
        return {"existe": True, "acessivel": True, "tam": fmt_size(os.path.getsize(p)),
                "mtime": mt, "mod": mt.strftime("%d/%m/%Y %H:%M")}
    return {"existe": False, "acessivel": True}


_HIST_CACHE = {"mtime": None, "dados": []}


def load_hist():
    try:
        mt = os.path.getmtime(HISTORICO_FILE)
    except OSError:
        return []
    if _HIST_CACHE["mtime"] != mt:
        try:
            with open(HISTORICO_FILE, "r", encoding="utf-8") as f:
                _HIST_CACHE["dados"] = json.load(f)
            _HIST_CACHE["mtime"] = mt
        except (OSError, ValueError):
            logging.exception("Falha ao ler o histórico")
    return list(_HIST_CACHE["dados"])


def save_hist(reg):
    h = ([reg] + load_hist())[:200]
    tmp = HISTORICO_FILE + ".tmp"
    try:
        with open(tmp, "w", encoding="utf-8") as f:
            json.dump(h, f, ensure_ascii=False, indent=2)
        os.replace(tmp, HISTORICO_FILE)
    except OSError:
        logging.exception("Falha ao gravar o histórico")
        return False
    _HIST_CACHE["dados"] = h
    try:
        _HIST_CACHE["mtime"] = os.path.getmtime(HISTORICO_FILE)
    except OSError:
        _HIST_CACHE["mtime"] = None
    return True


def hist_dt(r):
    try:
        return datetime.strptime(r.get("data", ""), "%d/%m/%Y %H:%M:%S")
    except ValueError:
        return None


def hist_periodo(dias=None, operacao=None):
    corte = (datetime.now() - timedelta(days=dias - 1)).date() if dias else None
    out = []
    for r in load_hist():
        dt = hist_dt(r)
        if dt is None or (corte and dt.date() < corte):
            continue
        if operacao and r.get("operacao") != operacao:
            continue
        out.append((dt, r))
    return out


def hist_tom(r):
    s = r.get("status", "")
    if "Problema" in s:
        return "err"
    if "ressalva" in s:
        return "warn"
    if s.startswith(("Sucesso", "Verificado")):
        return "ok"
    return "err"


def rotulo_status(r):
    s = r.get("status", "")
    if s == "Sucesso":
        return "Alocado"
    if s.startswith("Verificado — "):
        return s.split("— ", 1)[1]
    return s or "—"


