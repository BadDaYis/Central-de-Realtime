def _excel_para_copiar(caminho):
    try:
        ativo = win32com.client.GetActiveObject("Excel.Application")
        for w in ativo.Workbooks:
            if _mesmo_arquivo(w.FullName, caminho) or w.Name.lower() == os.path.basename(caminho).lower():
                return ativo, w, False
    except Exception:
        pass
    xl = win32com.client.DispatchEx("Excel.Application")
    xl.Visible = False
    xl.DisplayAlerts = False
    xl.AskToUpdateLinks = False
    xl.AutomationSecurity = 3
    wb = xl.Workbooks.Open(caminho, UpdateLinks=0, ReadOnly=True)
    return xl, wb, True


def _inserir_no_inicio(doc, texto):
    doc.Range(0, 0).InsertBefore(texto.replace("\r\n", "\n").replace("\n", "\r"))


def _colar_bloco(doc, rng, como_tabela):
    ultimo = None
    for tentativa in range(3):
        try:
            if como_tabela:
                rng.Copy()
                time.sleep(0.2)
                doc.Range(0, 0).PasteExcelTable(False, False, False)
            else:
                rng.CopyPicture(1 if tentativa == 0 else 2, 2)
                time.sleep(0.2)
                doc.Range(0, 0).Paste()
            return
        except Exception as e:
            ultimo = e
            time.sleep(0.4)
    raise ultimo


def montar_email_outlook(vf, status, texto, blocos=None, enviar=False):
    if not OUTLOOK_OK:
        return False, MOTIVO_SEM_OUTLOOK
    pythoncom.CoInitialize()
    abertos = []
    avisos = []
    try:
        outlook = win32com.client.Dispatch("Outlook.Application")
        ns = outlook.GetNamespace("MAPI")
        alvo = (status or {}).get("alvo")
        modelo = (status or {}).get("modelo")
        if alvo:
            mail = ns.GetItemFromID(alvo["entry"], alvo["store"]).ReplyAll()
        else:
            mail = outlook.CreateItem(0)
            if modelo:
                rascunho = ns.GetItemFromID(modelo["entry"], modelo["store"]).ReplyAll()
                for r in rascunho.Recipients:
                    novo = mail.Recipients.Add(r.Address)
                    novo.Type = r.Type
                mail.Recipients.ResolveAll()
            data_ref = (status or {}).get("data_ref") or datetime.now().strftime("%d/%m")
            mail.Subject = (vf.get("assunto_novo") or vf["assunto_referencia"] + " - {data}").format(data=data_ref)

        doc = None
        try:
            doc = mail.GetInspector.WordEditor
        except Exception:
            logging.exception("WordEditor indisponível")

        if doc is None:
            mail.HTMLBody = _texto_para_html(texto) + ("" if not alvo or not vf.get("manter_historico") else mail.HTMLBody)
        else:
            if alvo and not vf.get("manter_historico", False):
                try:
                    doc.Bookmarks("_MailOriginal").Range.Delete()
                except Exception:
                    pass
            livros = {}
            for bloco in reversed(blocos or []):
                try:
                    caminho = bloco["planilha"]
                    if not os.path.exists(caminho):
                        avisos.append(f"Planilha não encontrada: {os.path.basename(caminho)}")
                        continue
                    if caminho not in livros:
                        livros[caminho] = _excel_para_copiar(caminho)
                        if livros[caminho][2]:
                            abertos.append(livros[caminho][:2])
                    wb = livros[caminho][1]
                    rng = wb.Worksheets(bloco["aba"]).Range(bloco["intervalo"])
                    _inserir_no_inicio(doc, "\n")
                    _colar_bloco(doc, rng, bloco.get("como") == "tabela")
                    if bloco.get("titulo"):
                        _inserir_no_inicio(doc, f"\n{bloco['titulo']}:\n")
                except Exception as e:
                    logging.exception("Falha no bloco %s", bloco)
                    avisos.append(f"Bloco '{bloco.get('titulo') or bloco.get('intervalo')}': {e}")
            _inserir_no_inicio(doc, texto.rstrip() + "\n\n")

        if enviar:
            mail.Send()
            msg = "E-mail enviado pelo Outlook."
        else:
            mail.Display()
            msg = "Rascunho aberto no Outlook para revisão."
        if avisos:
            msg += " Atenção: " + "; ".join(avisos)
        return True, msg
    except Exception as e:
        logging.exception("Falha ao montar e-mail")
        return False, f"Erro ao montar o e-mail: {e}"
    finally:
        for xl, wb in abertos:
            try:
                wb.Close(SaveChanges=False)
                xl.Quit()
            except Exception:
                pass
        pythoncom.CoUninitialize()


