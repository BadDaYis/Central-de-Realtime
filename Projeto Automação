        x, y = max(0, (sw - w) // 2), max(0, (sh - h) // 2 - 20)
        self.root.geometry(f"{w}x{h}+{x}+{y}")

        self.ativo, self.nome_op, self._ult_int = "home", None, None
        self.toast = Toaster(self.root)
        self.root.report_callback_exception = self._erro_callback
        self.root.bind("<F5>", lambda e: self._recarregar())
        self._pend_avisados = set()
        self.root.after(20000, self._poll_emails)
        self._montar_sidebar()
        self._montar_topo()
        self.body = Rolagem(self.main)
        self.body.pack(fill="both", expand=True, pady=(8, 0))

        self.root.bind_all("<MouseWheel>", self._wheel)
        self.root.bind_all("<Button-4>", lambda e: self._wheel(e, -1))
        self.root.bind_all("<Button-5>", lambda e: self._wheel(e, 1))
        self._tick()
        self.show_home()

    def run(self):
        self.root.mainloop()

    def _sair(self):
        if messagebox.askyesno("Sair", "Deseja realmente fechar a Central do RTA?",
                               icon="question", parent=self.root):
            self.root.destroy()

    def _erro_callback(self, exc, val, tb):
        logging.error("Erro na interface", exc_info=(exc, val, tb))
        self.toast.show("Erro inesperado", f"{val}\nDetalhes em app.log.", "err")

    def _recarregar(self):
        if self.ativo == "home":
            self.show_home()
        elif self.ativo == "hist":
            self.show_historico()
        elif self.ativo == "atalhos":
            self.show_atalhos()
        elif self.ativo == "cfg_emails":
            self.show_config_emails()
        elif self.nome_op:
            self.show_operacao(self.nome_op)

    def _poll_emails(self):
        pares = [(chave_verificacao(n, v), v, n) for n, v in verificacoes_monitoradas()]
        if pares and OUTLOOK_OK:
            def fim(res):
                pend = {k for k, r in (res or {}).items() if r.get("estado") == "pendente"}
                ativos = {k for k, v, n in pares if k in pend and em_horario(OPERACOES[n].get("horario", ""))}
                novos = ativos - self._pend_avisados
                self._pend_avisados = pend
                if novos:
                    nomes = [f"{n} · {v['nome']}" for k, v, n in pares if k in novos]
                    self.toast.show("E-mail aguardando ação", juntar(nomes), "warn")

            run_async(self.root, lambda: consultar_caixa([(k, v) for k, v, _ in pares]), fim)
        self.root.after(5 * 60 * 1000, self._poll_emails)

    def _wheel(self, e, passos=None):
        if isinstance(e.widget, tk.Text):
            return
        if passos is None:
            passos = -max(1, abs(e.delta) // 120) if e.delta > 0 else max(1, abs(e.delta) // 120)

        # Descobre o widget sob o cursor e verifica se está dentro da sidebar
        try:
            alvo = self.root.winfo_containing(e.x_root, e.y_root)
        except (KeyError, tk.TclError):
            return
        w = alvo
        while w is not None:
            if w is self.side:
                self.side_scroll.rolar(passos)
                return
            w = w.master
        self.body.rolar(passos)

