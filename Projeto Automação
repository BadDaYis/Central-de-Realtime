        def render(_=None):
            for w in lista.winfo_children():
                w.destroy()
            dias = None if filtros["dias"] == "all" else int(filtros["dias"])
            itens = hist_periodo(dias, filtros["op"] or None)
            tk.Label(lista, text=f"{len(itens)} {'registro' if len(itens) == 1 else 'registros'}",
                     font=fnt(9), bg=C.INK, fg=C.MUTED, anchor="w").pack(fill="x", padx=28, pady=(8, 8))
            self._feed(lista, itens, com_data=True, titulo_vazio="Nenhum registro neste filtro.",
                       texto_vazio="Amplie o período ou escolha outra operação.")

        def set_f(chave):
            def f(v):
                filtros[chave] = v
                render()
