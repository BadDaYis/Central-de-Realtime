        tk.Label(tx, text=f"{cfg.get('operacao', '')} · {cfg.get('nome', '')}", font=fnt(10, "bold"),
                 bg=bg, fg=C.TEXT, anchor="w").pack(anchor="w")
        modo = "Thread do dia" if cfg.get("modo") == "thread" else "Responder recebido"
        tk.Label(tx, text=f"{modo}  ·  assunto contém \"{cfg.get('assunto', '')}\"", font=fnt(8),
                 bg=bg, fg=C.TEXT2, anchor="w").pack(anchor="w")
        if not sel:
            clicavel(row, lambda i=cfg.get("id"): self.show_config_emails(i), C.SURFACE, C.RAISED)

    if editar_id is None:
        tk.Frame(B, bg=C.INK, height=36).pack()
        return

    atual = next((dict(c) for c in lista if c.get("id") == editar_id), None)
    nova = atual is None
    atual = atual or {"modo": "thread", "dias_referencia": 0, "ciclo_min": 60, "manter_historico": False,
                      "corpo": "{saudacao}!\n\nSegue atualização.\n\nQualquer dúvida estou à disposição.",
                      "blocos_excel": [], "checklist": ["Revisar o rascunho no Outlook", "Enviar"]}

    secao(B, "Nova verificação" if nova else f"Editar: {atual.get('nome', '')}")
    form = tk.Frame(B, bg=C.SURFACE, padx=24, pady=18)
    form.pack(fill="x", padx=28)
    form.grid_columnconfigure((0, 1), weight=1, uniform="cfg")

    def campo(parent, rotulo, valor, dica="", linha=0, coluna=0, span=1):
        f = tk.Frame(parent, bg=C.SURFACE)
        f.grid(row=linha, column=coluna, columnspan=span, sticky="ew", padx=(0, 12), pady=(0, 10))
        tk.Label(f, text=rotulo, font=fnt(8), bg=C.SURFACE, fg=C.TEXT2, anchor="w").pack(fill="x")
        cp = Campo(f, dica, width=10)
        cp.pack(fill="x", pady=(2, 0))
        if valor not in (None, ""):
            preencher_campo(cp, valor)
        return cp

    def texto_longo(parent, rotulo, valor, altura, dica=""):
        tk.Label(parent, text=rotulo, font=fnt(8), bg=C.SURFACE, fg=C.TEXT2, anchor="w").pack(fill="x", pady=(6, 2))
        if dica:
            tk.Label(parent, text=dica, font=fnt(8), bg=C.SURFACE, fg=C.MUTED, anchor="w").pack(fill="x")
        t = tk.Text(parent, font=fnt(10), bg=C.INK, fg=C.TEXT, insertbackground=C.TEXT, height=altura,
                    width=1, bd=0, padx=10, pady=8, wrap="word", highlightthickness=1,
                    highlightbackground=C.LINE, highlightcolor=C.ACCENT)
        t.pack(fill="x")
        t.insert("1.0", valor or "")
        return t

    ops = sorted(OPERACOES)
    cp_op = campo(form, "Operação (existente ou nova)", atual.get("operacao"), "ex: Accor", 0, 0)
    cp_nome = campo(form, "Nome da verificação", atual.get("nome"), "ex: Report Pontual", 0, 1)
    tk.Label(form, text="Existentes: " + ", ".join(ops), font=fnt(8), bg=C.SURFACE, fg=C.MUTED,
             anchor="w", justify="left", wraplength=600).grid(row=1, column=0, columnspan=2, sticky="w",
                                                              pady=(0, 10))
    cp_desc = campo(form, "Descrição", atual.get("descricao"), "o que é verificado", 2, 0, 2)

    modo_box = tk.Frame(form, bg=C.SURFACE)
    modo_box.grid(row=3, column=0, columnspan=2, sticky="ew", pady=(0, 10))
    tk.Label(modo_box, text="Como funciona", font=fnt(8), bg=C.SURFACE, fg=C.TEXT2, anchor="w").pack(fill="x")
    seg_modo = Segmented(modo_box, [("Responder e-mail recebido", "responder"),
                                    ("Enviar no thread do dia", "thread")],
                         atual.get("modo", "responder"), lambda v: alternar_modo())
    seg_modo.pack(anchor="w", pady=(4, 0))

    cp_assunto = campo(form, "Trecho fixo do assunto (sem data/hora)", atual.get("assunto"),
                       "ex: Report Pontual - Accor", 4, 0, 2)

    fr_resp = tk.Frame(form, bg=C.SURFACE)
    fr_resp.grid_columnconfigure((0, 1), weight=1, uniform="r")
    cp_rem = campo(fr_resp, "Remetente (parte do nome ou e-mail, opcional)", atual.get("remetente"),
                   "ex: devmis.reports@foundever.com", 0, 0, 2)

    fr_thread = tk.Frame(form, bg=C.SURFACE)
    fr_thread.grid_columnconfigure((0, 1), weight=1, uniform="t")
    cp_novo = campo(fr_thread, "Assunto do e-mail do dia ({data} = dd/mm)", atual.get("assunto_novo"),
                    "ex: Report Pontual - Accor - {data}", 0, 0, 2)
    cp_ciclo = campo(fr_thread, "Ciclo entre envios (min, 0 = 1x por dia)", atual.get("ciclo_min", 60), "60", 1, 0)
    dia_box = tk.Frame(fr_thread, bg=C.SURFACE)
    dia_box.grid(row=1, column=1, sticky="ew", pady=(0, 10))
    tk.Label(dia_box, text="Data no assunto", font=fnt(8), bg=C.SURFACE, fg=C.TEXT2, anchor="w").pack(fill="x")
    seg_dia = Segmented(dia_box, [("Hoje", "0"), ("Ontem", "-1")], str(atual.get("dias_referencia", 0)))
    seg_dia.pack(anchor="w", pady=(4, 0))

    def alternar_modo():
        if seg_modo.valor == "thread":
            fr_resp.grid_forget()
            fr_thread.grid(row=5, column=0, columnspan=2, sticky="ew")
        else:
            fr_thread.grid_forget()
            fr_resp.grid(row=5, column=0, columnspan=2, sticky="ew")

    alternar_modo()

    extra = tk.Frame(form, bg=C.SURFACE)
    extra.grid(row=6, column=0, columnspan=2, sticky="ew")
    chk_hist = CheckRow(extra, "Manter o histórico do thread na resposta", nivel=0)
    chk_hist.pack(fill="x")
    chk_hist.set(bool(atual.get("manter_historico", False)))
    cp_hor = None
    if atual.get("operacao") not in OPERACOES or OPERACOES.get(atual.get("operacao"), {}).get("origem") == "config":
        hf = tk.Frame(extra, bg=C.SURFACE)
        hf.pack(fill="x", pady=(6, 0))
        hf.grid_columnconfigure((0, 1), weight=1, uniform="h")
        cp_hor = campo(hf, "Horário da operação (se for nova)", atual.get("horario"), "08:00 – 20:00", 0, 0)

    txt_corpo = texto_longo(extra, "Texto do e-mail", atual.get("corpo"), 7,
                            "Variáveis: {saudacao} (Bom dia/Boa tarde/Boa noite), {data} (dd/mm), {hora}")
    txt_check = texto_longo(extra, "Checklist (um item por linha)", "\n".join(atual.get("checklist") or []), 4)

    tk.Label(extra, text="Blocos da planilha", font=fnt(10, "bold"), bg=C.SURFACE, fg=C.TEXT,
             anchor="w").pack(fill="x", pady=(16, 0))
    tk.Label(extra, text="Intervalos do Excel colados no e-mail, na ordem abaixo: como imagem (print) "
                         "ou como tabela com a formatação.",
             font=fnt(8), bg=C.SURFACE, fg=C.MUTED, anchor="w", justify="left",
             wraplength=600).pack(fill="x", pady=(2, 6))
    blocos_box = tk.Frame(extra, bg=C.SURFACE)
    blocos_box.pack(fill="x")
    linhas_bloco = []

    def adicionar_bloco(b=None):
        b = b or {}
        f = tk.Frame(blocos_box, bg=C.RAISED, padx=12, pady=10)
        f.pack(fill="x", pady=(0, 4))
        f.grid_columnconfigure((0, 1, 2), weight=1, uniform="b")

        def mini(rot, val, dica, lin, col, span=1):
            g = tk.Frame(f, bg=C.RAISED)
            g.grid(row=lin, column=col, columnspan=span, sticky="ew", padx=(0, 8), pady=(0, 6))
            tk.Label(g, text=rot, font=fnt(8), bg=C.RAISED, fg=C.TEXT2, anchor="w").pack(fill="x")
            cp = Campo(g, dica, width=8)
            cp.pack(fill="x", pady=(2, 0))
            if val:
                preencher_campo(cp, val)
            return cp

        c_tit = mini("Título acima do bloco", b.get("titulo"), "ex: Parcial de Volumetria", 0, 0, 3)
        c_plan = mini("Planilha", b.get("planilha"), r"\\servidor\pasta\arquivo.xlsm", 1, 0, 2)

        def procurar():
            from tkinter import filedialog
            p = filedialog.askopenfilename(parent=self.root, title="Escolha a planilha",
                                           filetypes=[("Excel", "*.xlsx *.xlsm *.xls"), ("Todos", "*.*")])
            if p:
                preencher_campo(c_plan, os.path.normpath(p))

        Btn(f, "Procurar", procurar, kind="ghost", size=8, pady=4).grid(row=1, column=2, sticky="sw", pady=(0, 8))
        c_aba = mini("Aba", b.get("aba"), "ex: Resumo", 2, 0)
        c_int = mini("Intervalo", b.get("intervalo"), "ex: B2:M30", 2, 1)
        g = tk.Frame(f, bg=C.RAISED)
        g.grid(row=2, column=2, sticky="ew", pady=(0, 6))
        tk.Label(g, text="Colar como", font=fnt(8), bg=C.RAISED, fg=C.TEXT2, anchor="w").pack(fill="x")
        seg = Segmented(g, [("Imagem", "imagem"), ("Tabela", "tabela")], b.get("como", "imagem"))
        seg.pack(anchor="w", pady=(2, 0))
        item = {"frame": f, "titulo": c_tit, "planilha": c_plan, "aba": c_aba, "intervalo": c_int, "como": seg}

        def remover():
            linhas_bloco.remove(item)
            f.destroy()

        Btn(f, "Remover bloco", remover, kind="quiet", size=8, pady=2).grid(row=3, column=0, sticky="w")
        linhas_bloco.append(item)

    for b in atual.get("blocos_excel") or []:
        adicionar_bloco(b)
