                     font=fnt(9), bg=C.SURFACE, fg=C.MUTED, anchor="w").grid(row=0, column=2, sticky="w")
            desc = r.get("descricao", "")
            obs = r.get("observacoes", "")
            if obs:
                desc = f"{desc}   ({obs})"
            tk.Label(row, text=desc if len(desc) < 80 else desc[:77] + "...", font=fnt(9),
                     bg=C.SURFACE, fg=C.TEXT2, anchor="w").grid(row=0, column=3, sticky="w", padx=(0, 12))
