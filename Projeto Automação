                     justify="left", wraplength=340).pack(anchor="w", pady=(2, 0))
        for w in (t, body, *body.winfo_children()):
            w.bind("<Button-1>", lambda e: self._fechar(t))
        self.ativos.append(t)
        self.off[t] = 380
        self._layout()
        self._slide(t)
        self.root.after(4000 if tom == "ok" else 7000, lambda: self._fechar(t))

    def _slide(self, t):
        if t not in self.ativos:
            return
        self.off[t] = int(self.off[t] * 0.62)
        self._layout()
        if self.off[t] > 1:
            self.root.after(16, lambda: self._slide(t))

    def _layout(self):
        y = -22
        for t in reversed(self.ativos):
            t.place(relx=1, rely=1, x=-22 + self.off.get(t, 0), y=y, anchor="se")
            t.lift()
            y -= max(t.winfo_reqheight(), 48) + 8

    def _fechar(self, t):
        if t in self.ativos:
            self.ativos.remove(t)
            self.off.pop(t, None)
            t.destroy()
            self._layout()


# ============================================================
# LEITURA DE ORIGEM, CONVERSÃO DE VALORES E GRAVAÇÃO EM PLANILHA
# Com pywin32 + Excel instalado, a gravação é feita pelo próprio
# Excel (preserva macros, gráficos, tabelas dinâmicas e recalcula).
# Sem Excel, usa openpyxl como contingência.
# ============================================================

_RE_INT = re.compile(r"-?\d+")
_RE_MILHAR = re.compile(r"-?\d{1,3}(\.\d{3})+")
_RE_DEC_VIRGULA = re.compile(r"-?(\d{1,3}(\.\d{3})+|\d+),\d+")
_RE_DEC_PONTO = re.compile(r"-?\d+\.\d+")
_RE_DATA_BR = re.compile(r"(\d{2})/(\d{2})/(\d{4})(?:\s+(\d{1,2}):(\d{2})(?::(\d{2}))?)?")
_RE_DATA_ISO = re.compile(r"(\d{4})-(\d{2})-(\d{2})(?:[ T](\d{1,2}):(\d{2})(?::(\d{2}))?)?")
_RE_HORA = re.compile(r"(\d{1,2}):(\d{2})(?::(\d{2}))?")


def converter_valor(valor):
    if not isinstance(valor, str):
        return valor
    s = valor.strip()
    if not s:
        return None
    if _RE_INT.fullmatch(s):
        digitos = s.lstrip("-")
        if (len(digitos) > 1 and digitos.startswith("0")) or len(digitos) > 15:
            return s
        return int(s)
    if _RE_MILHAR.fullmatch(s):
        return int(s.replace(".", ""))
    if _RE_DEC_VIRGULA.fullmatch(s):
        return float(s.replace(".", "").replace(",", "."))
    if _RE_DEC_PONTO.fullmatch(s):
        return float(s)
    for rx, ordem in ((_RE_DATA_BR, (2, 1, 0)), (_RE_DATA_ISO, (0, 1, 2))):
        m = rx.fullmatch(s)
        if m:
            g = m.groups()
            try:
                return datetime(int(g[ordem[0]]), int(g[ordem[1]]), int(g[ordem[2]]),
                                int(g[3] or 0), int(g[4] or 0), int(g[5] or 0))
            except ValueError:
                return s
    m = _RE_HORA.fullmatch(s)
    if m:
        h, mi, se = int(m.group(1)), int(m.group(2)), int(m.group(3) or 0)
        if h < 24 and mi < 60 and se < 60:
            return dt_time(h, mi, se)
    return s


def _ler_texto(caminho):
    for enc in ("utf-8-sig", "cp1252"):
        try:
            with open(caminho, "r", encoding=enc, newline="") as f:
                return f.read()
        except UnicodeDecodeError:
            continue
    with open(caminho, "r", encoding="latin-1", newline="") as f:
        return f.read()


def _sem_linhas_vazias_no_fim(linhas):
    while linhas and all(v in (None, "") for v in linhas[-1]):
        linhas.pop()
    return linhas


def ler_origem(caminho, linha_inicio=1):
    ext = os.path.splitext(caminho)[1].lower()
    if ext in (".xlsx", ".xlsm"):
        wb = load_workbook(caminho, read_only=True, data_only=True)
        try:
            linhas = [list(r) for r in wb.active.iter_rows(min_row=linha_inicio, values_only=True)]
        finally:
            wb.close()
        return _sem_linhas_vazias_no_fim(linhas)
    if ext in (".csv", ".tsv", ".txt"):
        texto = _ler_texto(caminho)
        amostra = texto[:8192]
        if ext == ".tsv":
            delim = "\t"
        else:
            try:
                delim = csv.Sniffer().sniff(amostra, delimiters=";,\t|").delimiter
            except csv.Error:
                delim = ";" if amostra.count(";") > amostra.count(",") else ","
        linhas = list(csv.reader(io.StringIO(texto), delimiter=delim))[linha_inicio - 1:]
        return _sem_linhas_vazias_no_fim([[converter_valor(v) for v in r] for r in linhas])
    raise ValueError(f"Formato de origem não suportado: {ext}")


def _mesmo_arquivo(a, b):
    return os.path.normcase(os.path.abspath(a)) == os.path.normcase(os.path.abspath(b))


def _valor_para_com(v):
    if isinstance(v, dt_time):
        return (v.hour * 3600 + v.minute * 60 + v.second) / 86400
    return v


def _gravar_excel_com(caminho, sheet_nome, celula, dados, max_colunas=None):
    pythoncom.CoInitialize()
    xl = wb = None
    instancia_propria = False
    try:
        try:
            ativo = win32com.client.GetActiveObject("Excel.Application")
            for w in ativo.Workbooks:
                if _mesmo_arquivo(w.FullName, caminho) or w.Name.lower() == os.path.basename(caminho).lower():
                    xl, wb = ativo, w
                    break
        except Exception:
            pass

        if wb is None:
            xl = win32com.client.DispatchEx("Excel.Application")
            instancia_propria = True
            xl.Visible = False
            xl.DisplayAlerts = False
            xl.AskToUpdateLinks = False
            xl.EnableEvents = False
            xl.AutomationSecurity = 3
            wb = xl.Workbooks.Open(caminho, UpdateLinks=0, ReadOnly=False)

        if wb.ReadOnly:
            return False, "A planilha está aberta por outra pessoa (somente leitura). Tente de novo em instantes."

        nomes = [s.Name for s in wb.Worksheets]
        if sheet_nome not in nomes:
            return False, f"Aba '{sheet_nome}' não encontrada. Abas disponíveis: {', '.join(nomes)}"
        ws = wb.Worksheets(sheet_nome)

        row_ini, col_ini = coordinate_to_tuple(celula)
        usado = ws.UsedRange
        ult_lin = usado.Row + usado.Rows.Count - 1
        ult_col = col_ini + max_colunas - 1 if max_colunas else usado.Column + usado.Columns.Count - 1
        if ult_lin >= row_ini and ult_col >= col_ini:
            ws.Range(ws.Cells(row_ini, col_ini), ws.Cells(ult_lin, ult_col)).ClearContents()

        n_col = max(len(r) for r in dados)
        matriz = tuple(tuple(_valor_para_com(v) for v in list(r) + [None] * (n_col - len(r))) for r in dados)
        ws.Range(ws.Cells(row_ini, col_ini),
                 ws.Cells(row_ini + len(matriz) - 1, col_ini + n_col - 1)).Value = matriz
        xl.Calculate()
        wb.Save()
        return True, ""
    finally:
        if instancia_propria:
            try:
                if wb is not None:
                    wb.Close(SaveChanges=False)
            except Exception:
                pass
            try:
                xl.Quit()
            except Exception:
                pass
        xl = wb = None
        pythoncom.CoUninitialize()


def _gravar_openpyxl(caminho, sheet_nome, celula, dados, max_colunas=None):
    try:
        wb = load_workbook(caminho, keep_vba=caminho.lower().endswith(".xlsm"))
    except PermissionError:
        return False, "Planilha aberta no Excel. Feche-a e tente novamente."
    except Exception as e:
        return False, f"Erro ao abrir planilha destino: {e}"
    try:
        if sheet_nome not in wb.sheetnames:
            return False, f"Aba '{sheet_nome}' não encontrada. Abas disponíveis: {', '.join(wb.sheetnames)}"
        ws = wb[sheet_nome]
        row_ini, col_ini = coordinate_to_tuple(celula)
        ult_col = col_ini + max_colunas - 1 if max_colunas else max(ws.max_column, col_ini)
        for row in ws.iter_rows(min_row=row_ini, max_row=max(ws.max_row, row_ini),
                                min_col=col_ini, max_col=ult_col):
            for cell in row:
                cell.value = None
        for r_idx, row_data in enumerate(dados):
            for c_idx, valor in enumerate(row_data):
                ws.cell(row=row_ini + r_idx, column=col_ini + c_idx, value=valor)
        try:
            wb.save(caminho)
        except PermissionError:
            return False, "Planilha aberta no Excel. Feche-a e tente novamente."
        return True, ""
    finally:
        wb.close()


def gravar_na_planilha(caminho, sheet_nome, celula, dados, max_colunas=None):
    if not dados:
        return False, "Nenhum dado para colar."
    n_col = max(len(r) for r in dados)
    resumo = f"{len(dados)} linhas × {n_col} colunas coladas em '{sheet_nome}!{celula}'"
    if WIN32_OK:
        try:
