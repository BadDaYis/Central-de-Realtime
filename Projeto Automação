def clicavel(frame, command, bg, hover):
    estado = {"hover": False}

    def entrar(e=None):
        if not estado["hover"]:
            estado["hover"] = True
            pintar(hover)

    def sair(e=None):
        if estado["hover"] and not ponteiro_dentro(frame):
            estado["hover"] = False
            pintar(bg)

    def pintar(cor):
        def walk(w):
            try:
                if w.cget("bg") in (bg, hover):
                    w.configure(bg=cor)
            except tk.TclError:
                pass
            for c in w.winfo_children():
                walk(c)
        if frame.winfo_exists():
            walk(frame)

    def bind(w):
        w.bind("<Enter>", entrar, add="+")
        w.bind("<Leave>", sair, add="+")
        w.bind("<Button-1>", lambda e: command(), add="+")
        try:
            w.configure(cursor="hand2")
        except tk.TclError:
            pass
        for c in w.winfo_children():
            bind(c)

    bind(frame)


