def _slug(texto):
    s = re.sub(r"[^a-z0-9]+", "-", texto.lower().encode("ascii", "ignore").decode()).strip("-")
    return s or "verificacao"


def _show_config_emails(self, editar_id=None):
    B = self._pagina("Configurar e-mails",
                     "E-mails que a Central acompanha no Outlook. Vale para toda a equipe.", "cfg_emails")
    lista = carregar_config_emails()

    cab = tk.Frame(B, bg=C.INK)
    cab.pack(fill="x", padx=28, pady=(16, 0))
    tk.Label(cab, text=f"Arquivo: {ARQ_CONFIG_EMAILS}", font=fnt(8), bg=C.INK, fg=C.MUTED,
             anchor="w").pack(side="left")
    Btn(cab, "Nova verificação", lambda: self.show_config_emails("__nova__"),
