        cores = {n: d["cor"] for n, d in OPERACOES.items()}
        Segmented(barra, ops, "", set_f("op"), cores).pack(side="left", padx=(12, 0))
        lista.pack(fill="x")
        render()
        tk.Frame(B, bg=C.INK, height=36).pack()

