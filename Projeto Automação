def _em_notebook():
    """True quando executado dentro do Jupyter."""
    return "ipykernel" in sys.modules


def _modulo_instalado(nome_modulo):
    """Verifica a presença do módulo sem importá-lo."""
    try:
        return importlib.util.find_spec(nome_modulo) is not None
    except (ImportError, ValueError):
        return False


def _chromium_instalado():
    """
    Verifica se o Chromium do Playwright já foi baixado.
    Não usa a API do Playwright, para evitar conflito com o
    event loop do Jupyter.
    """
    base = os.environ.get("PLAYWRIGHT_BROWSERS_PATH")
    if base == "0":
        return True  # navegadores dentro do pacote; não dá para checar
    if base:
        pasta = Path(base)
    else:
        local = os.environ.get(
            "LOCALAPPDATA", str(Path.home() / "AppData" / "Local")
        )
        pasta = Path(local) / "ms-playwright"
    return pasta.exists() and any(pasta.glob("chromium-*"))


def _executar_comando(cmd, descricao):
    """Executa um comando e devolve True se terminou sem erro."""
    print(f"   ⏳ {descricao}...")
    try:
        r = subprocess.run(
            cmd, capture_output=True, text=True, timeout=900
        )
        if r.returncode != 0:
            ultimas = "\n".join((r.stderr or r.stdout).splitlines()[-6:])
            print(f"   ❌ Falhou:\n{ultimas}")
            return False
        print("   ✅ Concluído.")
        return True
    except Exception as e:
        print(f"   ❌ Erro ao executar: {e}")
        return False


def _reiniciar_programa():
    """Notebook: pede reinício do kernel. Script: reabre uma vez."""
    if _em_notebook():
        # Interrompe o "Run All" para o usuário reiniciar o kernel
        raise RuntimeError(
            "Bibliotecas instaladas. Reinicie o kernel "
            "(Kernel > Restart) e execute novamente."
        )

    if os.environ.get(_FLAG_REINICIO) == "1":
        print("⚠️ Ainda há pendências após o reinício automático.")
        print("   Feche o programa e abra novamente.")
        sys.exit(1)

    print("\n🔁 Reiniciando o programa para carregar as bibliotecas...")
    env = dict(os.environ)
    env[_FLAG_REINICIO] = "1"
    subprocess.Popen([sys.executable, *sys.argv], env=env)
    sys.exit(0)


def verificar_dependencias():
    print("🔎 Verificando dependências...")
    faltando = [
        (m, p, d) for m, p, d in DEPENDENCIAS
        if not _modulo_instalado(m)
    ]
    instalou_algo = False

    # ── 1. Bibliotecas Python ────────────────────────────────
    if faltando:
        pacotes = [p for _, p, _ in faltando]
        print("\n⚠️ Bibliotecas ausentes:")
        for _, pacote, desc in faltando:
            print(f"   • {pacote:<16} {desc}")

        comando_manual = f'"{sys.executable}" -m pip install ' + " ".join(pacotes)
        print(f"\n💡 Comando manual:\n   {comando_manual}\n")

        if not AUTO_INSTALAR:
            print("Execute o comando acima e abra o programa novamente.")
            sys.exit(1)

        ok = _executar_comando(
            [sys.executable, "-m", "pip", "install",
             "--disable-pip-version-check", *pacotes],
            "Instalando " + ", ".join(pacotes)
        )
        if not ok:
            print("\n❌ Instalação automática falhou (proxy/permissão?).")
            print(f"   Execute manualmente:\n   {comando_manual}")
            sys.exit(1)

        importlib.invalidate_caches()
        instalou_algo = True

    # ── 2. Navegador do Playwright ───────────────────────────
    if _modulo_instalado("playwright") and not _chromium_instalado():
        print("\n⚠️ Chromium do Playwright não encontrado.")
        comando_chromium = f'"{sys.executable}" -m playwright install chromium'
        print(f"💡 Comando manual:\n   {comando_chromium}\n")

        if AUTO_INSTALAR:
            ok = _executar_comando(
                [sys.executable, "-m", "playwright", "install", "chromium"],
                "Baixando Chromium"
            )
            instalou_algo = instalou_algo or ok
        else:
            print("Execute o comando acima e abra o programa novamente.")
            sys.exit(1)

    # ── 3. Tkinter (não instalável via pip) ──────────────────
    if not _modulo_instalado("tkinter"):
        print("❌ tkinter ausente. Reinstale o Python marcando 'tcl/tk and IDLE'.")
        sys.exit(1)

    # ── 4. Resultado ─────────────────────────────────────────
    if instalou_algo:
        _reiniciar_programa()

    print("✅ Todas as dependências estão instaladas.\n")


if not FROZEN:
    verificar_dependencias()


