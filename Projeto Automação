        marca.pack(fill="x")
        tk.Label(marca, text="WFM Real Time", font=fnt(16, "bold", num=True),
                 bg=C.SIDEBAR, fg=C.TEXT, anchor="w").pack(fill="x")
        tk.Label(marca, text="Central do RTA", font=fnt(9), bg=C.SIDEBAR, fg=C.MUTED,
