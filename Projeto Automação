def ler_clipboard_tsv(root, max_colunas=None):
    try:
        texto = root.clipboard_get()
    except tk.TclError:
        return False, "Clipboard vazio. Exporte os dados do CMS primeiro."

    dados = []
    for i, linha in enumerate(texto.splitlines()):
        colunas = linha.rstrip("\r").split("\t")
        while colunas and not colunas[-1].strip():
            colunas.pop()
        if not colunas:
            continue
        if max_colunas and len(colunas) > max_colunas:
            return False, (
                f"Linha {i + 1} tem {len(colunas)} colunas, "
                f"mas o máximo permitido é {max_colunas}.\n\n"
                f"Verifique as configurações de exportação do CMS:\n"
                f"  • Separador: (guia)\n"
                f"  • Delimitador: (nenhum)\n"
                f"  • ☐ Legendas e Cabeçalhos: DESMARCADO\n\n"
                f"Conteúdo da linha:\n{linha[:200]}"
            )
        dados.append(colunas)

    if not dados:
        return False, "Clipboard vazio. Exporte os dados do CMS primeiro."
    return True, dados


def colar_clipboard_na_planilha(caminho_planilha, sheet_nome, dados, celula="A2", max_colunas=6):
    if len(dados) < 2:
        return False, f"Apenas {len(dados)} linha(s) no clipboard. Verifique se exportou corretamente do CMS."
    valores = [[converter_valor(v) for v in r] for r in dados]
    return gravar_na_planilha(caminho_planilha, sheet_nome, celula, valores, max_colunas)


