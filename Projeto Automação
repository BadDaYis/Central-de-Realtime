def _colunas_planas(df):
    cols = []
    for c in df.columns:
        partes = c if isinstance(c, tuple) else (c,)
        nome = next((str(p) for p in reversed(partes) if not str(p).startswith("Unnamed")), "")
        cols.append(" ".join(nome.split()).lower())
    return cols


def _titulo_tabela(df):
    c = df.columns[0]
    return str(c[0]).lower() if isinstance(c, tuple) else ""


def _hora_curta(txt):
    m = _RE_HORA.match(str(txt).strip())
    if not m:
        return None
    h, mi = int(m.group(1)), int(m.group(2))
    return f"{h}h{mi:02d}" if mi else f"{h}h"


def _num(valor):
    try:
        v = float(str(valor).replace(",", "."))
        return None if v != v else v
    except (TypeError, ValueError):
        return None


def _descrever_intervalos(selecionados, validos):
    if not selecionados:
        return "nenhum intervalo"
    if len(selecionados) == len(validos):
        return "todos os intervalos"
    faltam = [l for l in validos if l not in selecionados]
    if len(validos) >= 5 and len(faltam) <= 2:
        return "todos os intervalos exceto " + juntar([l["hora"] for l in faltam])
    return juntar([l["hora"] for l in selecionados])


def _campos_por_intervalo(linhas):
    validas = [l for l in linhas if l["hora"] and (l["rec"] or 0) > 0]
    campos = {}
    for chave, pref in (("dvol", "vol"), ("daht", "aht")):
        positivos = [l for l in validas if (l[chave] or 0) > 0]
        campos[f"intervalos_{pref}"] = _descrever_intervalos(positivos, validas)
        ordem = sorted(positivos, key=lambda l: l[chave], reverse=True)
        if ordem:
            campos[f"maior_{pref}_hora"] = ordem[0]["hora"]
            campos[f"maior_{pref}_pct"] = _fmt_pct(ordem[0][chave])
        if len(ordem) > 1:
            campos[f"segundo_{pref}_hora"] = ordem[1]["hora"]
            campos[f"segundo_{pref}_pct"] = _fmt_pct(ordem[1][chave])
    com_sla = [l for l in validas if l["sla"] is not None]
    if com_sla:
        menor = min(com_sla, key=lambda l: l["sla"])
        campos["menor_ns_hora"] = menor["hora"]
        campos["menor_ns_pct"] = _fmt_pct(menor["sla"])
    return campos


def _linhas_intervalo(df, cols, c_rec, c_dvol, c_daht, c_sla):
    linhas = []
    for vals in df.itertuples(index=False):
        vals = list(vals)
        hora = _hora_curta(vals[0])
        if not hora:
            continue
        linhas.append({"hora": hora, "rec": _num(vals[c_rec]),
                       "dvol": _pct_para_float(vals[c_dvol]),
                       "daht": _pct_para_float(vals[c_daht]),
                       "sla": _pct_para_float(vals[c_sla])})
    return linhas


def extrair_sla_pontual(html, tipo):
    try:
        import pandas as pd
        from io import StringIO
    except ImportError:
        return False, "pandas não instalado. Execute: pip install pandas lxml"
    try:
        tabelas = pd.read_html(StringIO(html))
    except Exception as e:
        return False, f"Não li as tabelas do e-mail: {e}"

    canais, linhas, total = {}, [], None

    if tipo == "justificativa_chat":
        for df in tabelas:
            cols = _colunas_planas(df)
            if "canal" in cols and "sla" in cols and not canais:
                c_canal, c_sla = cols.index("canal"), cols.index("sla")
                c_dvol = cols.index("% desvio forecast") if "% desvio forecast" in cols else None
                c_daht = cols.index("% desvio tma") if "% desvio tma" in cols else None
                for vals in df.itertuples(index=False):
                    vals = list(vals)
                    nome = " ".join(str(vals[c_canal]).split()).lower()
                    chave = ("SAC & Sinistro" if "sac" in nome else "Portal Segurado" if "portal segurado" in nome
                             else "Total" if "total" in nome else None)
                    if chave:
                        canais[chave] = {
                            "sla": _pct_para_float(vals[c_sla]),
                            "desvio_vol": _pct_para_float(vals[c_dvol]) if c_dvol is not None else None,
                            "desvio_aht": _pct_para_float(vals[c_daht]) if c_daht is not None else None}
            elif cols and cols[0] == "intervalos" and "sac" in _titulo_tabela(df) and not linhas:
                if all(c in cols for c in ("recebidas", "% desvio forecast", "% desvio tma", "sla")):
                    linhas = _linhas_intervalo(df, cols, cols.index("recebidas"), cols.index("% desvio forecast"),
                                               cols.index("% desvio tma"), cols.index("sla"))
        total = canais.get("SAC & Sinistro") or canais.get("Total")
    else:
        for df in tabelas:
            cols = _colunas_planas(df)
            if all(c in cols for c in ("% sla", "% desvio", "% desvio tmo", "recebidas")):
                c_sla, c_dvol = cols.index("% sla"), cols.index("% desvio")
                c_daht, c_rec = cols.index("% desvio tmo"), cols.index("recebidas")
                for vals in df.itertuples(index=False):
                    vals = list(vals)
                    rotulo = str(vals[0]).strip().lower()
                    if rotulo in ("intervalos", "total"):
                        total = {"sla": _pct_para_float(vals[c_sla]),
                                 "desvio_vol": _pct_para_float(vals[c_dvol]),
                                 "desvio_aht": _pct_para_float(vals[c_daht])}
                linhas = _linhas_intervalo(df, cols, c_rec, c_dvol, c_daht, c_sla)
                canais["Total"] = total
                break

    if not total or total.get("sla") is None:
        return False, "Não encontrei a tabela de SLA no e-mail."

    sla = total["sla"]
    abaixo = sla < 80.0
    campos = _campos_por_intervalo(linhas)
    if total.get("desvio_vol") is not None:
        campos["desvio_vol"] = _fmt_pct(total["desvio_vol"])
    if total.get("desvio_aht") is not None:
        campos["desvio_aht"] = _fmt_pct(total["desvio_aht"])

    partes = [f"{nome}: SLA {_fmt_pct(canais[nome]['sla'])}%"
              for nome in ("SAC & Sinistro", "Portal Segurado", "Total")
              if canais.get(nome) and canais[nome].get("sla") is not None]
    resumo = " · ".join(partes)
    resumo += " — abaixo de 80%, justificar." if abaixo else " — no alvo."
    portal = canais.get("Portal Segurado")
    if tipo == "justificativa_chat" and portal and portal.get("sla") is not None and portal["sla"] < 80:
        resumo += " Atenção: Portal Segurado abaixo de 80%; ajuste o texto do Portal."
    curto = f"SLA {_fmt_pct(sla)}%" + (" (abaixo de 80%)" if abaixo else "")

    return True, {"canais": canais, "sla": sla, "desvio_vol": total.get("desvio_vol"),
                  "abaixo": abaixo, "campos": campos, "intervalos": len(linhas),
                  "resumo": resumo, "resumo_curto": curto}


