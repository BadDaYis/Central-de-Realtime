# CAIXA DE ENTRADA — STATUS DE RESPOSTA E MONTAGEM DE E-MAIL
#
# Cada verificação com a chave "modo" é acompanhada no Outlook:
#
#   modo "responder": chega um e-mail (ex.: pontual Cardif) e é
#       preciso responder. Status = recebido hoje? já respondido
#       (por você ou por outra pessoa)?
#
#   modo "thread": você envia atualizações no thread do dia
#       (ex.: "Report Pontual - Accor - 29/10"). Status = thread
#       existe? quando foi seu último envio? passou do ciclo?
#
# Chaves usadas (em OPERACOES ou no config_verificacoes.json):
#   assunto            trecho fixo do assunto (sem data/hora)
#   remetente          parte do nome ou e-mail de quem envia (responder)
#   assunto_novo       assunto do e-mail do dia, com {data} (thread)
#   dias_referencia    0 = data de hoje no assunto, -1 = ontem (thread)
#   ciclo_min          minutos entre envios; 0 = uma vez por dia (thread)
#   manter_historico   False = responde sem o histórico do thread
#   corpo              texto inicial do e-mail ({data}, {hora}, {saudacao})
#   blocos_excel       [{"titulo","planilha","aba","intervalo","como"}]
#                      como = "imagem" ou "tabela"
# ============================================================

PR_LAST_VERB = "http://schemas.microsoft.com/mapi/proptag/0x10810003"
PR_LAST_VERB_TIME = "http://schemas.microsoft.com/mapi/proptag/0x10820040"
_PREFIXOS = ("re:", "res:", "enc:", "fw:", "fwd:", "tr:", "rv:", "aw:", "wg:")
_STATUS_CACHE = {}
_STATUS_LOCK = threading.Lock()


def chave_verificacao(nome_op, vf):
    return vf.get("id") or f"{nome_op}::{vf['nome']}"


def _dt_local(t):
    return datetime(t.year, t.month, t.day, t.hour, t.minute, t.second)


def _sem_prefixo(assunto):
    s = (assunto or "").strip()
    mudou = True
    while mudou:
        mudou = False
        for p in _PREFIXOS:
            if s.lower().startswith(p):
                s = s[len(p):].strip()
                mudou = True
    return s


def _eh_resposta(assunto):
    return (assunto or "").strip().lower().startswith(_PREFIXOS)


def _remetente_txt(item):
    partes = [getattr(item, "SenderName", "") or "", getattr(item, "SenderEmailAddress", "") or ""]
    try:
        if (item.SenderEmailType or "").upper() == "EX":
            usuario = item.Sender.GetExchangeUser()
            if usuario is not None:
                partes.append(usuario.PrimarySmtpAddress or "")
    except Exception:
        pass
    return " ".join(partes).lower()


def _saudacao(agora=None):
    h = (agora or datetime.now()).hour
    return "Bom dia" if h < 12 else "Boa tarde" if h < 18 else "Boa noite"


def _fmt_ha(minutos):
    minutos = int(minutos)
    if minutos < 60:
        return f"{minutos} min"
    return f"{minutos // 60}h{minutos % 60:02d}"


class _Caixa:
    def __init__(self):
        pythoncom.CoInitialize()
        self.outlook = win32com.client.Dispatch("Outlook.Application")
        self.ns = self.outlook.GetNamespace("MAPI")
        self.inbox = self.ns.GetDefaultFolder(6)
        self.enviados = self.ns.GetDefaultFolder(5)

    def fechar(self):
        self.outlook = self.ns = self.inbox = self.enviados = None
        pythoncom.CoUninitialize()

    def itens(self, pasta, trecho, dias=3, de_mim=False):
        colecao = pasta.Items
        try:
            colecao = colecao.Restrict(
                "@SQL=\"urn:schemas:httpmail:subject\" LIKE '%" + trecho.replace("'", "''") + "%'")
        except Exception:
            logging.warning("Restrict indisponível em %s", pasta.Name)
        campo = "[SentOn]" if de_mim else "[ReceivedTime]"
        colecao.Sort(campo, True)
        corte = datetime.now() - timedelta(days=dias)
        saida = []
        for item in colecao:
            try:
                if getattr(item, "Class", 43) != 43:
                    continue
                quando = _dt_local(item.SentOn if de_mim else item.ReceivedTime)
                if quando < corte:
                    break
                if trecho.lower() not in (item.Subject or "").lower():
                    continue
                saida.append({"item": item, "assunto": item.Subject or "", "quando": quando, "de_mim": de_mim,
                              "nome": "você" if de_mim else (item.SenderName or "")})
            except Exception:
                continue
        return saida

    def status_responder(self, vf):
        trecho = vf["assunto_referencia"]
        remetente = (vf.get("remetente") or "").lower()
        hoje = datetime.now().date()
        recebidos = [x for x in self.itens(self.inbox, trecho, dias=1)
                     if not _eh_resposta(x["assunto"]) and x["quando"].date() == hoje
                     and (not remetente or remetente in _remetente_txt(x["item"]))]
        if not recebidos:
            return {"estado": "vazio", "texto": "Nenhum e-mail recebido hoje"}
        orig = recebidos[0]
        item, quando = orig["item"], orig["quando"]
        alvo = {"entry": item.EntryID, "store": item.Parent.StoreID, "assunto": orig["assunto"]}
        base = {"alvo": alvo, "recebido": quando, "assunto": orig["assunto"]}

        try:
            verbo = item.PropertyAccessor.GetProperty(PR_LAST_VERB)
            if verbo in (102, 103):
                try:
                    q = _dt_local(item.PropertyAccessor.UTCToLocalTime(
                        item.PropertyAccessor.GetProperty(PR_LAST_VERB_TIME)))
                except Exception:
                    q = None
                hora = f" às {q:%H:%M}" if q else ""
                return {**base, "estado": "ok", "texto": f"Respondido por você{hora}"}
        except Exception:
            pass

        assunto_orig = _sem_prefixo(orig["assunto"])
        for x in self.itens(self.enviados, assunto_orig, dias=1, de_mim=True):
            if x["quando"] >= quando and _eh_resposta(x["assunto"]):
                return {**base, "estado": "ok", "texto": f"Respondido por você às {x['quando']:%H:%M}"}
        for x in self.itens(self.inbox, assunto_orig, dias=1):
            if x["quando"] >= quando and _eh_resposta(x["assunto"]):
                return {**base, "estado": "ok", "texto": f"Respondido por {x['nome']} às {x['quando']:%H:%M}"}

        espera = (datetime.now() - quando).total_seconds() / 60
        return {**base, "estado": "pendente",
                "texto": f"Recebido às {quando:%H:%M} · sem resposta há {_fmt_ha(espera)}"}

    def status_thread(self, vf):
        trecho = vf["assunto_referencia"]
        data_ref = (datetime.now() + timedelta(days=vf.get("dias_referencia", 0))).strftime("%d/%m")
        todos = (self.itens(self.enviados, trecho, dias=7, de_mim=True)
                 + self.itens(self.inbox, trecho, dias=7))
        todos.sort(key=lambda x: x["quando"], reverse=True)
        do_dia = [x for x in todos if data_ref in x["assunto"]]
        base = {"data_ref": data_ref}

        if not do_dia:
            modelo = todos[0] if todos else None
            if modelo:
                base["modelo"] = {"entry": modelo["item"].EntryID, "store": modelo["item"].Parent.StoreID}
            return {**base, "estado": "pendente", "texto": f"Thread de {data_ref} ainda não existe"}

        ultimo = do_dia[0]
        base["alvo"] = {"entry": ultimo["item"].EntryID, "store": ultimo["item"].Parent.StoreID,
                        "assunto": ultimo["assunto"]}
        meus = [x for x in do_dia if x["de_mim"]]
        if not meus:
            return {**base, "estado": "pendente",
                    "texto": f"Último no thread às {ultimo['quando']:%H:%M} ({ultimo['nome']}) · você ainda não enviou"}
        meu = meus[0]["quando"]
        ciclo = int(vf.get("ciclo_min") or 0)
        decorrido = (datetime.now() - meu).total_seconds() / 60
        if ciclo and decorrido >= ciclo:
            return {**base, "estado": "pendente",
                    "texto": f"Seu último envio às {meu:%H:%M}, há {_fmt_ha(decorrido)} (ciclo de {ciclo} min)"}
        texto = f"Enviado por você às {meu:%H:%M}"
        if ciclo:
            texto += f" · próximo até {meu + timedelta(minutes=ciclo):%H:%M}"
        return {**base, "estado": "ok", "texto": texto}

    def status(self, vf):
        if vf.get("modo") == "thread":
            return self.status_thread(vf)
        return self.status_responder(vf)


def consultar_caixa(pares):
    if not OUTLOOK_OK:
        return {chave: {"estado": "erro", "texto": MOTIVO_SEM_OUTLOOK} for chave, _ in pares}
    resultado = {}
    try:
        caixa = _Caixa()
    except Exception as e:
        logging.exception("Outlook indisponível")
        return {chave: {"estado": "erro", "texto": f"Outlook indisponível: {e}"} for chave, _ in pares}
    try:
        for chave, vf in pares:
            try:
                r = caixa.status(vf)
            except Exception as e:
                logging.exception("Falha ao consultar %s", chave)
                r = {"estado": "erro", "texto": f"Erro ao consultar: {e}"}
            r["em"] = datetime.now()
            resultado[chave] = r
            with _STATUS_LOCK:
                _STATUS_CACHE[chave] = r
    finally:
        caixa.fechar()
    return resultado


def status_em_cache(chave, idade_max=180):
    with _STATUS_LOCK:
        r = _STATUS_CACHE.get(chave)
    if r and (datetime.now() - r["em"]).total_seconds() <= idade_max:
        return r
    return None


