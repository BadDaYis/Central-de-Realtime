def _texto_para_html(texto):
    html = texto.replace("&", "&amp;").replace("<", "&lt;").replace(">", "&gt;")
    html = html.replace("\n\n", "</p><p>").replace("\n", "<br>")
    return (
        '<div style="font-family:Calibri,Arial,sans-serif;font-size:11pt;color:#333;">'
        f'<p>{html}</p></div>'
    )


def _outlook_inbox():
    outlook = win32com.client.Dispatch("Outlook.Application")
    return outlook, outlook.GetNamespace("MAPI").GetDefaultFolder(6)


def _buscar_email(inbox, assunto, remetente=None):
    itens = inbox.Items
    try:
        filtro = "@SQL=\"urn:schemas:httpmail:subject\" LIKE '%" + assunto.replace("'", "''") + "%'"
        itens = itens.Restrict(filtro)
    except Exception:
        logging.warning("Restrict indisponível; varrendo a caixa inteira")
    itens.Sort("[ReceivedTime]", True)
    for item in itens:
        try:
            if assunto.lower() not in (item.Subject or "").lower():
                continue
            if remetente and remetente.lower() not in (item.SenderName or "").lower():
                continue
            return item
        except Exception:
            continue
    return None


def _montar_email(assunto, corpo_html, responder_a=None, remetente=None):
    outlook, inbox = _outlook_inbox()
    if responder_a:
        original = _buscar_email(inbox, responder_a, remetente)
        if original is None:
            return None, f"Nenhum e-mail encontrado com o assunto '{responder_a}'."
        mail = original.ReplyAll()
    else:
        mail = outlook.CreateItem(0)
        mail.Subject = assunto
    mail.HTMLBody = corpo_html
    return mail, ""


def preparar_outlook(assunto, corpo_html, responder_a=None, remetente=None):
    if not OUTLOOK_OK:
        return False, MOTIVO_SEM_OUTLOOK
    try:
        mail, erro = _montar_email(assunto, corpo_html, responder_a, remetente)
        if mail is None:
            return False, erro
        mail.Display()
        return True, "E-mail aberto no Outlook para revisão."
    except Exception as e:
        logging.exception("Falha ao preparar e-mail")
        return False, f"Erro ao abrir Outlook: {e}"


def enviar_outlook(assunto, corpo_html, responder_a=None, remetente=None):
    if not OUTLOOK_OK:
        return False, MOTIVO_SEM_OUTLOOK
    try:
        mail, erro = _montar_email(assunto, corpo_html, responder_a, remetente)
        if mail is None:
            return False, erro
        mail.Send()
        return True, "E-mail enviado com sucesso pelo Outlook."
    except Exception as e:
        logging.exception("Falha ao enviar e-mail")
        return False, f"Erro ao enviar: {e}"


