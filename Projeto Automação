    def _tick(self):
        now = datetime.now()
        self.lbl_hora.configure(text=now.strftime("%H:%M:%S"))
        self.lbl_data.configure(text=f"{DIAS_PT[now.weekday()]}, {now.day} de {MESES_PT[now.month].lower()}")
        ini, fim = intervalo(now)
        rest = int((fim - now).total_seconds())
        self.lbl_int.configure(text=f"{ini:%H:%M} – {fim:%H:%M}")
        self.lbl_cd.configure(text=f"Fecha em {rest // 60:02d}:{rest % 60:02d}",
                              fg=C.WARN if rest < 300 else C.TEXT2)
        if now.second % 15 == 0 or ini != self._ult_int:
            self._ult_int = ini
            self.trilho.draw()
        self.root.after(1000 - now.microsecond // 1000, self._tick)

    def _pagina(self, titulo, sub, ativo, nome_op=None, voltar=None):
        self.ativo, self.nome_op = ativo, nome_op
        self.lbl_titulo.configure(text=titulo)
        self.lbl_sub.configure(text=sub)
        for w in self.lbl_volta.winfo_children():
            w.destroy()
        if voltar:
            Btn(self.lbl_volta, f"‹  {voltar[0]}", voltar[1], kind="quiet", size=9, padx=0, pady=2).pack(anchor="w")
        self.body.limpar()
        self.atualizar_contexto()
        return self.body.inner

    def atualizar_contexto(self):
        self._nav()
        d = OPERACOES.get(self.nome_op) if self.nome_op else None
        eventos = [(dt, OPERACOES.get(r.get("operacao"), {}).get("cor", C.ACCENT))
                   for dt, r in hist_periodo(1, self.nome_op)]
        if d:
            self.trilho.set(parse_horario(d.get("horario", "")), eventos, d["cor"])
            st = "dentro do horário agora" if em_horario(d["horario"]) else "fora do horário agora"
            self.lbl_janela.configure(text=f"{self.nome_op} atende das {d['horario'].replace('–', 'às')}, {st}. "
                                           f"Os pontos marcam suas ações de hoje.")
        else:
            self.trilho.set(None, eventos, C.ACCENT)
            self.lbl_janela.configure(text="Todas as operações. Os pontos marcam suas ações de hoje, na cor de cada operação.")

    def _nav(self):
        cont = {}
        for _, r in hist_periodo(1):
            cont[r.get("operacao")] = cont.get(r.get("operacao"), 0) + 1
        assinatura = (self.ativo, tuple(sorted(cont.items(), key=lambda x: str(x[0]))))
        if assinatura == getattr(self, "_nav_assinatura", None):
            return
        self._nav_assinatura = assinatura
        for w in self.nav.winfo_children():
            w.destroy()
        self._nav_item("Painel do dia", "home", None, None, self.show_home)
        tk.Label(self.nav, text="Operações", font=fnt(9), bg=C.SIDEBAR, fg=C.MUTED,
                 anchor="w").pack(fill="x", padx=26, pady=(18, 6))
        for nome, d in OPERACOES.items():
            pronto = op_configurada(d)
            extra = cont.get(nome, 0) if pronto else "em breve"
            cmd = (lambda n=nome: self.show_operacao(n)) if pronto else None
            self._nav_item(nome, f"op:{nome}", d["cor"], extra, cmd)
        tk.Frame(self.nav, bg=C.LINE, height=1).pack(fill="x", padx=26, pady=14)
        self._nav_item("Acesso rápido", "atalhos", None, None, self.show_atalhos)
        self._nav_item("Configurar e-mails", "cfg_emails", None, None, lambda: self.show_config_emails())
        self._nav_item("Histórico", "hist", None, None, self.show_historico)

    def _nav_item(self, texto, chave, cor, extra, cmd):
        ativo = self.ativo == chave
        bg = C.SURFACE if ativo else C.SIDEBAR
        row = tk.Frame(self.nav, bg=bg)
        row.pack(fill="x", padx=12, pady=1)
        tk.Frame(row, bg=(cor or C.ACCENT) if ativo else bg, width=3).pack(side="left", fill="y")
        if cor:
            ponto(row, cor if cmd else C.MUTED, bg).pack(side="left", padx=(12, 0))
        tk.Label(row, text=texto, font=fnt(10, "bold" if ativo else "normal"), bg=bg,
                 fg=C.TEXT if cmd else C.MUTED, anchor="w", pady=8,
                 padx=10 if cor else 13).pack(side="left", fill="x", expand=True)
        if isinstance(extra, int):
            tk.Label(row, text=str(extra) if extra else "", font=fnt(9, "bold", num=True), bg=bg,
                     fg=C.TEXT2, padx=12).pack(side="right")
        elif extra:
            tk.Label(row, text=extra, font=fnt(8), bg=bg, fg=C.MUTED, padx=12).pack(side="right")
        if cmd and not ativo:
            clicavel(row, cmd, C.SIDEBAR, C.SIDE_HOVER)
        elif ativo and cmd:
            clicavel(row, cmd, C.SURFACE, C.SURFACE)

    def _feed(self, parent, itens, com_data=False, titulo_vazio="", texto_vazio=""):
        if not itens:
            vazio(parent, titulo_vazio, texto_vazio)
            return
        box = tk.Frame(parent, bg=C.INK)
        box.pack(fill="x", padx=28)
        for dt, r in itens:
            row = tk.Frame(box, bg=C.SURFACE, padx=18, pady=9)
            row.pack(fill="x", pady=(0, 2))
            for col, ms in ((0, 120 if com_data else 86), (1, 130), (2, 96)):
                row.grid_columnconfigure(col, minsize=ms)
            row.grid_columnconfigure(3, weight=1)
            tk.Label(row, text=dt.strftime("%d/%m  %H:%M" if com_data else "%H:%M:%S"),
                     font=fnt(10, "bold", num=True), bg=C.SURFACE, fg=C.TEXT, anchor="w").grid(row=0, column=0, sticky="w")
            op = tk.Frame(row, bg=C.SURFACE)
            op.grid(row=0, column=1, sticky="w")
            cor = OPERACOES.get(r.get("operacao"), {}).get("cor", C.MUTED)
            ponto(op, cor, C.SURFACE).pack(side="left")
            tk.Label(op, text=r.get("operacao", ""), font=fnt(9, "bold"), bg=C.SURFACE,
                     fg=C.TEXT, padx=8).pack(side="left")
