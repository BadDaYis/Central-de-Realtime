class Trilho(tk.Canvas):
    def __init__(self, parent, ini=240, fim=1440):
        super().__init__(parent, height=62, bg=parent.cget("bg"), highlightthickness=0)
        self.ini, self.fim = ini, fim
        self.janela, self.eventos, self.cor = None, [], C.ACCENT
        self.bind("<Configure>", lambda e: self.draw())

    def set(self, janela, eventos, cor):
        self.janela, self.eventos, self.cor = janela, eventos, cor
        self.draw()

    def draw(self):
        self.delete("all")
        w = self.winfo_width()
        if w < 80:
            return
        now = datetime.now()
        m = now.hour * 60 + now.minute + now.second / 60
        pad, total = 14, self.fim - self.ini
        usable = w - 2 * pad
        n = total // 30
        slot = usable / n
        y0, y1 = 22, 38

        def x(minuto):
            return pad + (minuto - self.ini) / total * usable

        for i in range(n):
            a = self.ini + i * 30
            b = a + 30
            dentro = self.janela is None or self.janela[0] <= a < self.janela[1]
            if not dentro:
                cor = C.RAIL_OFF
            elif b <= m:
                cor = C.RAIL_PAST
            else:
                cor = C.RAIL_NEXT
            x0, x1 = pad + i * slot + 1, pad + (i + 1) * slot - 1
            self.create_rectangle(x0, y0, x1, y1, fill=cor, width=0)
            if a <= m < b:
                self.create_rectangle(x0, y0, x0 + (x1 - x0) * (m - a) / 30, y1, fill=self.cor, width=0)
        for hh in range(self.ini // 60, self.fim // 60 + 1, 2):
            self.create_text(x(hh * 60), 52, text=f"{hh % 24:02d}h", fill=C.MUTED, font=fnt(8, num=True))
        for dt, c in self.eventos:
            mm = dt.hour * 60 + dt.minute + 15 - (dt.minute % 30)
            if self.ini <= mm <= self.fim:
                xx = x(mm)
                self.create_oval(xx - 3, 9, xx + 3, 15, fill=c, outline="")
        if self.ini <= m <= self.fim:
            xx = x(m)
            self.create_line(xx, y0 - 5, xx, y1 + 5, fill=C.TEXT, width=2)


