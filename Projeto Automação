def _pct_para_float(valor):
    if valor is None:
        return None
    s = str(valor).strip().replace("%", "").replace(",", ".")
    if not s or s.lower() in ("-", "nan", "none"):
        return None
    try:
        return float(s)
    except ValueError:
        return None


def _fmt_pct(x):
    if x is None:
        return ""
    if float(x) == int(x):
        return str(int(x))
    return f"{float(x):.1f}".replace(".", ",")


def preencher_campo(cp, valor):
