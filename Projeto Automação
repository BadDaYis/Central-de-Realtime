class Etapas(tk.Canvas):
    NOMES = ("Base", "Destino", "Origem", "Confirmar")

    def __init__(self, parent, cor):
        super().__init__(parent, height=34, bg=parent.cget("bg"), highlightthickness=0)
        self.cor, self.atual = cor, 0
        self.bind("<Configure>", lambda e: self.draw())

    def set(self, atual):
        self.atual = atual
        self.draw()

    def draw(self):
        self.delete("all")
        w = self.winfo_width()
        if w < 100:
            return
        f = tkfont.Font(family=F.UI, size=10, weight="bold")
        seg = w / len(self.NOMES)
        for i, nome in enumerate(self.NOMES):
            x, y = i * seg + 12, 17
            feito, atual = i < self.atual, i == self.atual
            if feito:
                self.create_oval(x - 11, y - 11, x + 11, y + 11, fill=self.cor, outline="")
                self.create_line(x - 5, y, x - 1, y + 4, x + 6, y - 4, fill=C.INK, width=2.4,
                                 capstyle="round", joinstyle="round")
            else:
                self.create_oval(x - 11, y - 11, x + 11, y + 11, fill=C.INK,
                                 outline=self.cor if atual else C.LINE, width=2)
                self.create_text(x, y, text=str(i + 1), font=fnt(9, "bold", num=True),
                                 fill=self.cor if atual else C.MUTED)
            self.create_text(x + 20, y, text=nome, anchor="w", font=(F.UI, 10, "bold"),
                             fill=C.TEXT if (feito or atual) else C.MUTED)
            if i < len(self.NOMES) - 1:
                x0 = x + 20 + f.measure(nome) + 14
                x1 = (i + 1) * seg + 12 - 24
                if x1 > x0:
                    self.create_line(x0, y, x1, y, fill=self.cor if feito else C.LINE, width=2)


def _show_alocar(self, nome_op):
    d = OPERACOES[nome_op]
    cor = d["cor"]
    B = self._pagina("Alocar arquivo", f"{nome_op}: {d['descricao']}", f"op:{nome_op}", nome_op,
                     (nome_op, lambda: self.show_operacao(nome_op)))
    estado = {"base": None, "arq": None, "orig": None, "busca": "", "dl": list_downloads(),
              "info": {}, "ultimo": None}

    etapas = Etapas(B, cor)
    etapas.pack(fill="x", padx=28, pady=(18, 0))

    secao(B, "Base", "pasta onde o arquivo vai ficar", pady=(22, 10))
    sec_base = tk.Frame(B, bg=C.INK)
    sec_base.pack(fill="x", padx=28)
    secao(B, "Arquivo de destino", "o arquivo que será criado ou substituído", pady=(26, 10))
    sec_dest = tk.Frame(B, bg=C.INK)
    sec_dest.pack(fill="x", padx=28)
    cab_orig = secao(B, "Arquivo de origem", "da sua pasta Downloads", pady=(26, 10))
    busca = Campo(cab_orig, "Buscar pelo nome", width=26)
    Btn(cab_orig, "Atualizar lista", lambda: recarregar_dl(), kind="ghost", size=9, pady=5).pack(side="right")
    busca.pack(side="right", padx=(0, 8))
    sec_orig = tk.Frame(B, bg=C.INK)
    sec_orig.pack(fill="x", padx=28)
    secao(B, "Confirmar", pady=(26, 10))
    sec_res = tk.Frame(B, bg=C.INK)
    sec_res.pack(fill="x", padx=28)
    tk.Frame(B, bg=C.INK, height=40).pack()

    def limpar(f):
        for w in f.winfo_children():
            w.destroy()

    def pintar_etapas():
        etapas.set(0 if not estado["base"] else 1 if not estado["arq"] else 2 if not estado["orig"] else 3)

    def render_base():
        limpar(sec_base)
        for nb, db in d["bases"].items():
            sel = estado["base"] == nb
            t = tk.Frame(sec_base, bg=C.RAISED if sel else C.SURFACE, padx=18, pady=12,
                         highlightthickness=2, highlightbackground=cor if sel else C.SURFACE)
            t.pack(side="left", padx=(0, 10))
            bg = t.cget("bg")
            tk.Label(t, text=nb, font=fnt(11, "bold"), bg=bg, fg=cor if sel else C.TEXT, anchor="w").pack(anchor="w")
            tipo_aloc = db.get("tipo_alocacao", "mover")
            if tipo_aloc == "colar_planilha":
                cauda = f"→ {db['sheet']} ({os.path.basename(db['planilha'])})"
            else:
                cauda = "\\" + "\\".join(destino_base(db).replace("/", "\\").rstrip("\\").split("\\")[-2:])
            tk.Label(t, text=cauda if len(cauda) < 60 else "..." + cauda[-55:],
                     font=fnt(8), bg=bg, fg=C.MUTED, anchor="w").pack(anchor="w")
            if not sel:
                clicavel(t, lambda n=nb: selecionar_base(n), C.SURFACE, C.RAISED)

    def selecionar_base(nb):
        estado.update(base=nb, arq=None, orig=None, info={})
        arquivos = d["bases"][nb]["arquivos"]
        if len(arquivos) == 1:
            estado["arq"] = arquivos[0]
        render_base()
        render_dest()
        render_orig()
        render_res()
        pintar_etapas()
        dest = destino_base(d["bases"][nb])

        def carregar():
            return {nome_arquivo(a): check_dest(dest, nome_arquivo(a))
                    for a in arquivos}

        def pronto(infos):
            if estado["base"] == nb and infos:
                estado["info"] = infos
                render_dest()
                render_res()

        run_async(sec_dest, carregar, pronto)

    def render_dest():
        limpar(sec_dest)
        if not estado["base"]:
            vazio(sec_dest, "Escolha a base primeiro.", "Os arquivos de destino aparecem aqui.", padx=0)
            return
        base_cfg = d["bases"][estado["base"]]
        tipo_aloc = base_cfg.get("tipo_alocacao", "mover")
        for arq in base_cfg["arquivos"]:
            nf = nome_arquivo(arq)
            sel = estado["arq"] is arq
            r = tk.Frame(sec_dest, bg=C.SURFACE, padx=18, pady=10, highlightthickness=2,
                         highlightbackground=cor if sel else C.SURFACE)
            r.pack(fill="x", pady=(0, 4))
            esq = tk.Frame(r, bg=C.SURFACE)
            esq.pack(side="left", fill="x", expand=True)
            tk.Label(esq, text=nf, font=fnt(10, "bold"), bg=C.SURFACE, fg=cor if sel else C.TEXT,
                     anchor="w").pack(anchor="w")
            desc = arq["descricao"]
            if tipo_aloc == "colar_planilha":
                desc = f"{desc}  —  lê da linha {base_cfg.get('linha_inicio_origem', 2)} até o fim"
            tk.Label(esq, text=desc, font=fnt(9), bg=C.SURFACE, fg=C.TEXT2, anchor="w").pack(anchor="w")
            info = estado["info"].get(nf)
            if info:
                t, c = status_destino(info)
                if info.get("existe"):
                    t = f"{t}   {info['tam']}"
            else:
                t, c = "verificando...", C.MUTED
            tk.Label(r, text=t, font=fnt(8), bg=C.SURFACE, fg=c).pack(side="right")
            if not sel:
                clicavel(r, lambda a=arq: selecionar_arq(a), C.SURFACE, C.RAISED)

    def selecionar_arq(arq):
        estado["arq"] = arq
        render_dest()
        render_orig()
        render_res()
        pintar_etapas()

    def recarregar_dl():
        estado["dl"] = list_downloads()
        if estado["orig"] and not any(a["caminho"] == estado["orig"]["caminho"] for a in estado["dl"]):
            estado["orig"] = None
        render_orig()
        render_res()
        pintar_etapas()

    def on_busca():
        estado["busca"] = busca.valor().lower()
        render_orig()

    busca.on_change = on_busca

    def render_orig():
        limpar(sec_orig)
        # Se é clipboard, não precisa selecionar arquivo
        if estado["base"] and d["bases"].get(estado["base"], {}).get("tipo_alocacao") == "colar_clipboard":
            estado["orig"] = {"nome": "clipboard (CMS)", "caminho": "__clipboard__",
                              "ext": ".txt", "tam_fmt": "—", "mtime": datetime.now(),
                              "mod": "agora"}
            f = tk.Frame(sec_orig, bg=C.SURFACE, padx=18, pady=14,
                         highlightthickness=2, highlightbackground=cor)
            f.pack(fill="x")
            tk.Label(f, text="📋  Dados do clipboard (CMS)", font=fnt(11, "bold"),
                     bg=C.SURFACE, fg=cor, anchor="w").pack(anchor="w")
            tk.Label(f, text="Exporte do CMS → Área de Armazenamento antes de confirmar.\n"
                     "Separador: (guia) / Legendas: desmarcado / Tempos em segundos.",
                     font=fnt(9), bg=C.SURFACE, fg=C.TEXT2, anchor="w",
                     justify="left", wraplength=600).pack(anchor="w", pady=(4, 0))
            render_res()
            pintar_etapas()
            return
        if not estado["dl"]:
            vazio(sec_orig, "Nenhum arquivo em Downloads.",
                  f"Baixe o relatório do sistema e clique em Atualizar lista. Pasta lida: {PASTA_DOWNLOADS}", padx=0)
            return
        ext_alvo = estado["arq"]["extensao"].lower() if estado["arq"] else None
        hoje = datetime.now().date()
        itens = [a for a in estado["dl"] if estado["busca"] in a["nome"].lower()]

        def ordem(a):
            casa = ext_alvo is not None and a["ext"] == ext_alvo
            return (0 if casa and a["mtime"].date() == hoje else 1 if casa else 2, -a["mtime"].timestamp())

        itens.sort(key=ordem)
        if not itens:
            vazio(sec_orig, "Nenhum arquivo com esse nome.", "Confira a busca ou clique em Atualizar lista.", padx=0)
            return
        for a in itens[:8]:
            sel = estado["orig"] is not None and estado["orig"]["caminho"] == a["caminho"]
            r = tk.Frame(sec_orig, bg=C.SURFACE, padx=18, pady=9, highlightthickness=2,
                         highlightbackground=cor if sel else C.SURFACE)
            r.pack(fill="x", pady=(0, 3))
            esq = tk.Frame(r, bg=C.SURFACE)
            esq.pack(side="left", fill="x", expand=True)
            tk.Label(esq, text=a["nome"], font=fnt(10, "bold" if sel else "normal"), bg=C.SURFACE,
                     fg=cor if sel else C.TEXT, anchor="w").pack(anchor="w")
            tk.Label(esq, text=f"{a['tam_fmt']}      modificado {fmt_quando(a['mtime'])}", font=fnt(8),
                     bg=C.SURFACE, fg=C.MUTED, anchor="w").pack(anchor="w")
            casa = ext_alvo is not None and a["ext"] == ext_alvo
            pill(r, a["ext"], C.TEXT2 if casa or not ext_alvo else C.MUTED).pack(side="right")
            if casa and a["mtime"].date() == hoje:
                pill(r, "sugerido", C.OK).pack(side="right", padx=(0, 6))
            if not sel:
                clicavel(r, lambda x=a: selecionar_orig(x), C.SURFACE, C.RAISED)
        if len(itens) > 8:
            tk.Label(sec_orig, text=f"Mostrando 8 de {len(itens)} arquivos. Use a busca para achar os demais.",
                     font=fnt(9), bg=C.INK, fg=C.MUTED, anchor="w").pack(fill="x", pady=(4, 0))

    def selecionar_orig(a):
        estado["orig"] = a
        render_orig()
        render_res()
        pintar_etapas()

    def render_res():
        limpar(sec_res)
        if estado["ultimo"]:
            u = estado["ultimo"]
            ok = tk.Frame(sec_res, bg=C.SURFACE, padx=18, pady=12)
            ok.pack(fill="x", pady=(0, 10))
            tk.Frame(ok, bg=C.OK, width=3).pack(side="left", fill="y", padx=(0, 14))
            tx = tk.Frame(ok, bg=C.SURFACE)
            tx.pack(side="left", fill="x")
            tk.Label(tx, text=f"Arquivo alocado às {u['hora']}", font=fnt(10, "bold"), bg=C.SURFACE,
                     fg=C.OK, anchor="w").pack(anchor="w")
            tk.Label(tx, text=f"{u['de']}  →  {u['para']}", font=fnt(9), bg=C.SURFACE, fg=C.TEXT2,
                     anchor="w").pack(anchor="w")
            if u.get("abrir") and hasattr(os, "startfile"):
                Btn(ok, "Abrir destino", lambda p=u["abrir"]: os.startfile(p),
                    kind="ghost", size=9, pady=4).pack(side="right")
        base, arq, orig = estado["base"], estado["arq"], estado["orig"]
        if not (base and arq and orig):
            faltam = [n for n, v in (("a base", base), ("o arquivo de destino", arq),
                                     ("o arquivo de origem", orig)) if not v]
            vazio(sec_res, f"Falta escolher {juntar(faltam)}.",
                  "O resumo aparece aqui. Nada é movido até você confirmar.", padx=0)
            return
        nf = nome_arquivo(arq)
        base_cfg = d["bases"][base]
        dest_dir = destino_base(base_cfg)
        tipo_aloc = base_cfg.get("tipo_alocacao", "mover")

        card = tk.Frame(sec_res, bg=C.SURFACE, padx=24, pady=20)
        card.pack(fill="x")
        fluxo = tk.Frame(card, bg=C.SURFACE)
        fluxo.pack(fill="x")
        fluxo.grid_columnconfigure((0, 2), weight=1, uniform="fluxo")

        if tipo_aloc in ("colar_clipboard", "colar_planilha"):
            para_nome = f"{base_cfg['sheet']} ({os.path.basename(base_cfg['planilha'])})"
            para_onde = base_cfg["planilha"]
        else:
            para_nome = nf
            para_onde = dest_dir

        de_nome = "clipboard (CMS)" if tipo_aloc == "colar_clipboard" else orig["nome"]
        de_onde = "Área de Armazenamento do CMS" if tipo_aloc == "colar_clipboard" else "Downloads"
        for col, rot, nome_col, onde, c in ((0, "De", de_nome, de_onde, C.TEXT),
                                             (2, "Para", para_nome, para_onde, cor)):
            b = tk.Frame(fluxo, bg=C.SURFACE)
            b.grid(row=0, column=col, sticky="nw")
            tk.Label(b, text=rot, font=fnt(8), bg=C.SURFACE, fg=C.MUTED, anchor="w").pack(anchor="w")
            tk.Label(b, text=nome_col, font=fnt(12, "bold"), bg=C.SURFACE, fg=c, anchor="w",
                     wraplength=330, justify="left").pack(anchor="w")
            tk.Label(b, text=onde, font=fnt(8), bg=C.SURFACE, fg=C.TEXT2, anchor="w",
                     wraplength=330, justify="left").pack(anchor="w", pady=(2, 0))
        tk.Label(fluxo, text="→", font=fnt(22), bg=C.SURFACE, fg=C.MUTED, padx=18).grid(row=0, column=1)

        avisos = []
        if tipo_aloc == "colar_planilha":
            if not os.path.exists(base_cfg["planilha"]):
                avisos.append(("A planilha de destino não foi encontrada. Verifique a conexão de rede.", "err"))
            avisos.append((f"A aba '{base_cfg['sheet']}' será limpa antes de colar os dados.", "warn"))
            avisos.append((f"Os dados serão lidos a partir da linha {base_cfg.get('linha_inicio_origem', 2)} do arquivo de origem.", "warn"))
        else:
            info = estado["info"].get(nf)
            if info and not info.get("acessivel"):
                avisos.append(("A pasta de destino não está acessível agora. Confira a conexão com a rede.", "err"))
            elif info and info.get("existe"):
                avisos.append((f"O arquivo atual será substituído (modificado {fmt_quando(info['mtime'])}, {info['tam']}).", "warn"))
        if tipo_aloc != "colar_clipboard" and orig["ext"] != arq["extensao"].lower():
            avisos.append((f"A origem é {orig['ext']} e o destino espera {arq['extensao']}. "
                           f"Confira se escolheu o download certo.", "warn"))
        if tipo_aloc != "colar_clipboard" and orig["mtime"].date() != datetime.now().date():
            avisos.append((f"Este download é de {fmt_quando(orig['mtime'])}, não de hoje.", "warn"))
        if avisos:
            av = tk.Frame(card, bg=C.SURFACE)
            av.pack(fill="x", pady=(16, 0))
            for t, tom in avisos:
                aviso(av, t, tom)

        tk.Frame(card, bg=C.LINE, height=1).pack(fill="x", pady=16)
        acao = tk.Frame(card, bg=C.SURFACE)
        acao.pack(fill="x")
        btn = Btn(acao, "Executar alocação", kind="primary", size=11, padx=26, pady=10, enabled=False)
        chk = CheckRow(acao, "Revisei a origem e o destino",
                       on_change=lambda: btn.set(enabled=chk.valor, command=executar))
        chk.pack(side="left")
        btn.pack(side="right")

        def registrar(descricao, origem_nome, destino_nome, caminho_dest, status):
            ok_hist = save_hist({
                "data": datetime.now().strftime("%d/%m/%Y %H:%M:%S"),
                "tipo": "alocar", "operacao": nome_op,
                "descricao": descricao,
                "arquivo_origem": origem_nome,
                "arquivo_destino": destino_nome,
                "caminho_destino": caminho_dest,
                "status": status,
            })
            if not ok_hist:
                self.toast.show("Histórico não gravado",
                                "A ação foi feita, mas o registro falhou. Veja app.log.", "warn")

        def concluir(titulo, msg, de, para, abrir):
            self.toast.show(titulo, msg)
            estado["ultimo"] = {"hora": datetime.now().strftime("%H:%M:%S"),
                                "de": de, "para": para, "abrir": abrir}
            estado["orig"] = None
            estado["dl"] = list_downloads()
            self.atualizar_contexto()
            if sec_res.winfo_exists():
                render_dest()
                render_orig()
                render_res()
                pintar_etapas()

        def em_andamento(texto):
            btn.set(text=texto, enabled=False)

        def executar():
            if not chk.valor:
                return
            caminho = orig["caminho"]
            if tipo_aloc != "colar_clipboard" and not os.path.exists(caminho):
                self.toast.show("Arquivo de origem não encontrado",
                                f"{orig['nome']} saiu da pasta Downloads. Clique em Atualizar lista.", "err")
                return

            if tipo_aloc in ("colar_planilha", "colar_clipboard"):
                planilha_path = base_cfg["planilha"]
                sheet_nome = base_cfg["sheet"]
                plan_nome = os.path.basename(planilha_path)
                if not os.path.exists(planilha_path):
                    self.toast.show("Planilha de destino não encontrada", planilha_path, "err")
                    return

                if tipo_aloc == "colar_planilha":
                    celula_dest = base_cfg.get("celula", "A1")
                    linha_ini = base_cfg.get("linha_inicio_origem", 2)
                    origem_nome = orig["nome"]
                    descricao = f"{orig['nome']} → {sheet_nome} ({plan_nome})"
                    texto_conf = (f"Origem: {orig['nome']}\nPlanilha: {plan_nome}\nAba: {sheet_nome}\n"
                                  f"Célula: {celula_dest}\nLeitura a partir da linha: {linha_ini}\n\n"
                                  f"A aba será limpa e os dados serão colados. Continuar?")

                    def tarefa():
                        return colar_na_planilha(caminho, planilha_path, sheet_nome, celula_dest, linha_ini)
                else:
                    celula_dest = base_cfg.get("celula", "A2")
                    max_cols = base_cfg.get("max_colunas", 6)
                    ok_clip, clip = ler_clipboard_tsv(self.root, max_cols)
                    if not ok_clip:
                        self.toast.show("Erro no clipboard", clip, "err")
                        return
                    origem_nome = "clipboard (CMS)"
                    descricao = f"Clipboard → {sheet_nome} ({plan_nome})"
                    amostra = " | ".join(clip[0][:4])
                    texto_conf = (f"Dados do clipboard:\n  • {len(clip)} linhas × {max(len(r) for r in clip)} colunas\n"
                                  f"  • Primeira linha: {amostra}...\n\nPlanilha: {plan_nome}\nAba: {sheet_nome}\n"
                                  f"Célula: {celula_dest}\n\n"
                                  f"A aba será limpa (exceto cabeçalho) e os dados colados. Continuar?")

                    def tarefa():
                        return colar_clipboard_na_planilha(planilha_path, sheet_nome, clip, celula_dest, max_cols)

                if not messagebox.askyesno("Confirmar cola na planilha", texto_conf,
                                           icon="warning", parent=self.root):
                    self.toast.show("Operação cancelada", "Nada foi alterado.", "warn")
                    return

                em_andamento("Colando na planilha...")

                def fim(res):
                    sucesso, msg = res or (False, "Falha inesperada. Veja app.log.")
                    if not sucesso:
                        registrar(descricao, origem_nome, plan_nome, planilha_path, f"Problema: {msg}")
                        self.toast.show("Falha ao colar na planilha", msg, "err")
                        if btn.winfo_exists():
                            btn.set(text="Executar alocação", enabled=chk.valor, command=executar)
                        return
                    registrar(descricao, origem_nome, plan_nome, planilha_path, "Sucesso")
                    concluir("Base colada na planilha", msg, origem_nome,
                             f"{sheet_nome} ({plan_nome})", planilha_path)

                run_async(self.root, tarefa, fim)
                return

            if not os.path.isdir(dest_dir):
                pai = os.path.dirname(dest_dir.rstrip("\\/"))
                if not os.path.isdir(pai):
                    self.toast.show("Pasta de destino inacessível", dest_dir, "err")
                    return
                if not messagebox.askyesno("Criar pasta do período",
                                           f"A pasta abaixo ainda não existe:\n{dest_dir}\n\nCriar agora?",
                                           icon="question", parent=self.root):
                    return
                try:
                    os.makedirs(dest_dir, exist_ok=True)
                except OSError as e:
                    self.toast.show("Não foi possível criar a pasta", str(e), "err")
                    return

            if not messagebox.askyesno("Confirmar alocação",
                                       f"Origem: {orig['nome']}\nDestino: {nf}\nPasta: {dest_dir}\n\n"
                                       f"O arquivo será recortado e colado no destino. Continuar?",
                                       icon="warning", parent=self.root):
                self.toast.show("Alocação cancelada", "Nada foi movido.", "warn")
                return

            dp = os.path.join(dest_dir, nf)
            tmp = dp + ".rta_tmp"
            try:
                shutil.move(caminho, tmp)
            except PermissionError:
                self.toast.show("Sem permissão para mover",
                                "Feche o arquivo de origem e tente de novo.", "err")
                return
            except Exception as e:
                self.toast.show("Não foi possível alocar", str(e), "err")
                return
            try:
                os.replace(tmp, dp)
            except Exception as e:
                try:
                    shutil.move(tmp, caminho)
                except Exception:
                    logging.exception("Não foi possível devolver %s para Downloads", tmp)
                if isinstance(e, PermissionError):
                    self.toast.show("Destino em uso",
                                    "Feche o arquivo de destino (Excel ou outro usuário) e tente de novo.", "err")
                else:
                    self.toast.show("Não foi possível alocar", str(e), "err")
                return

            registrar(f"{nf} → {base}", orig["nome"], nf, dest_dir, "Sucesso")
            estado["info"][nf] = check_dest(dest_dir, nf)
            concluir("Arquivo alocado", f"{orig['nome']}  →  {nf}", orig["nome"], nf, dest_dir)

    render_base()
    if len(d["bases"]) == 1:
        selecionar_base(next(iter(d["bases"])))
    else:
        render_dest()
        render_orig()
        render_res()
        pintar_etapas()


